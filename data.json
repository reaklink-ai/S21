// DASHBOARD (INICIO)
// ══════════════════════════════════════════
function renderDashboard() {
  const pubs  = state.publicadores;
  const total = pubs.length;
  const anio  = anioHoy();

  // Stats del mes actual
  const { mesC: mesC_v, mesNombre, anio: anioMes } = mesActual();
  const participaron = pubs.filter(p=>{
    const r=p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesC_v];
    return r&&r.particip;
  }).length;
  const paux = pubs.filter(p=>{
    const r=p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesC_v];
    return r&&r.paux;
  }).length;
  const noPredicaron = total - participaron;
  const gruposActivos = GRUPOS_LISTA.filter(g => pubs.some(p=>p.grupo===g));
  const ancianos = pubs.filter(p=>p.anciano).length;
  const precursores = pubs.filter(p=>p.precursorReg||p.precursorEsp||p.misionero).length;

  // Bloque superintendentes — solo admin
  const esAdmin = currentUser && currentUser.rol === 'admin';
  const bloqueSuper = esAdmin ? (() => {
    const filas = gruposActivos.map(g => {
      const cfg = state.grupos?.[g] || {};
      const superPub = cfg.super ? pubs.find(p=>p.id===cfg.super) : null;
      const superNombre = superPub ? `${superPub.apellido}, ${superPub.nombre}` : '—';
      const miembros = pubs.filter(p=>p.grupo===g).length;
      const color = superPub ? 'var(--ink)' : 'var(--ink-3)';
      return `<tr>
        <td style="padding:9px 12px;font-weight:700;font-size:13px;color:var(--ink);white-space:nowrap">${g}</td>
        <td style="padding:9px 12px;font-size:13px;color:${color};font-weight:${superPub?'500':'400'}">${superNombre}</td>
        <td style="padding:9px 12px;font-size:12px;color:var(--ink-3);text-align:right">${miembros} miembros</td>
        <td style="padding:9px 12px;text-align:right">
          <button onclick="abrirModalGrupos()" style="font-size:11px;font-weight:600;padding:4px 10px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);color:var(--ink-2);cursor:pointer;transition:all .12s" onmouseover="this.style.background='var(--accent-lt)';this.style.color='var(--accent)';this.style.borderColor='var(--accent-mid)'" onmouseout="this.style.background='var(--surface-2)';this.style.color='var(--ink-2)';this.style.borderColor='var(--border)'">Editar</button>
        </td>
      </tr>`;
    }).join('');
    return `

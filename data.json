function renderGruposScreen() {
  const wrap = document.getElementById('gruposScreenWrap');
  if(!wrap) return;

  const anio = anioHoy();
  const { mesC, mesNombre } = mesActual();
  const esAnciano = currentUser && currentUser.rol === 'anciano' && currentUser.grupo;

  // Anciano solo ve su grupo; los demás ven todos
  const gruposActivos = GRUPOS_LISTA.filter(g => {
    if(esAnciano) return g === currentUser.grupo;
    return state.publicadores.some(p => p.grupo === g);
  });
  const sinGrupo = esAnciano ? [] : state.publicadores.filter(p => !p.grupo || p.grupo === '');

  // Paleta de colores para grupos — cíclica
  const tarjetas = gruposActivos.map((g) => {
    const miembros = state.publicadores.filter(p => p.grupo === g)
      .sort((a,b) => a.apellido.localeCompare(b.apellido));
    const info = state.grupos?.[g] || {};
    const superPub = info.super ? state.publicadores.find(p=>p.id===info.super) : null;
    const auxPub   = info.aux   ? state.publicadores.find(p=>p.id===info.aux)   : null;
    const superNombre = superPub ? `${superPub.apellido.split(' ')[0]}, ${superPub.nombre.split(' ')[0]}` : null;
    const auxNombre   = auxPub   ? `${auxPub.apellido.split(' ')[0]}, ${auxPub.nombre.split(' ')[0]}`   : null;

    const predicaron = miembros.filter(p => getReg(p,anio,mesC).particip).length;
    const noInf = miembros.length - predicaron;
    const paux = miembros.filter(p => getReg(p,anio,mesC).paux).length;
    const pct = miembros.length ? Math.round((predicaron/miembros.length)*100) : 0;
    const progClass = pct === 100 ? 'ok' : noInf > 0 ? 'warn' : '';

    const chips = [];
    if(noInf > 0) chips.push(`<span class="gs-chip gs-chip-warn"><span class="gs-chip-dot"></span>${noInf} sin informe</span>`);
    else          chips.push(`<span class="gs-chip gs-chip-ok"><span class="gs-chip-dot"></span>Al día</span>`);
    if(paux > 0)  chips.push(`<span class="gs-chip gs-chip-amber"><span class="gs-chip-dot"></span>${paux} prec. aux.</span>`);

    const items = miembros.map(p => {
      const tipo = tipoPrincipal(p);
      const color = TIPO_COLOR[tipo] || '#64748b';
      const initials = (p.apellido[0]||'') + (p.nombre[0]||'');
      return `<div class="gs-miembro" onclick="verPublicadorDesdeGrupo('${p.id}')">
        <div class="gs-miembro-avatar" style="background:${color}18;color:${color}">${initials}</div>
        <span class="gs-miembro-nombre">${escHtml(p.apellido)}, ${escHtml(p.nombre)}</span>
        <span class="gs-miembro-tipo" style="background:${color}18;color:${color}">${tipo}</span>
      </div>`;
    }).join('');

    const superInits = superPub ? (superPub.apellido[0]||'')+(superPub.nombre[0]||'') : '';

    return `<div class="gs-card">
      <div class="gs-card-hd">
        <div class="gs-card-hd-top">
          <div class="gs-card-nombre">${g}</div>
          <span class="gs-card-n">${miembros.length} miembros</span>
        </div>
        <div class="gs-card-super">
          ${superPub
            ? `<div class="gs-card-super-av">${superInits}</div>`
            : `<div class="gs-card-super-av vacio"><svg width="11" height="11" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>`
          }
          <div class="gs-card-super-info">
            <span class="gs-card-super-label">Superintendente</span>
            ${superNombre
              ? `<span class="gs-card-super-nombre">${superNombre}${auxNombre ? ` <span style="opacity:.7;font-weight:500">· ${auxNombre}</span>` : ''}</span>`
              : `<span class="gs-card-super-vacio">Sin asignar</span>`
            }
          </div>
        </div>
      </div>
      <div class="gs-progress-wrap">
        <div class="gs-progress-row">
          <span class="gs-progress-label">Informes ${mesNombre}</span>
          <span class="gs-progress-nums"><strong>${predicaron}</strong> / ${miembros.length}</span>
        </div>
        <div class="gs-progress-bar">
          <div class="gs-progress-fill ${progClass}" style="width:${pct}%"></div>
        </div>
      </div>
      <div class="gs-chips">${chips.join('')}</div>
      <div class="gs-miembros">${items}</div>
      <div class="gs-card-footer">
        <button class="gs-btn" onclick="_descargarPlantillaGrupo('${g}')">↓ Plantilla</button>
        <button class="gs-btn" onclick="importarInformes()" title="Importar informe de este grupo">↑ Importar</button>
        <button class="gs-btn gs-btn-prim" onclick="filtrarYVerGrupo('${g}')">Ver registros →</button>
      </div>
    </div>`;
  }).join('');

  const sinGrupoBloque = sinGrupo.length ? `
    <div class="gs-card gs-card-singrupo">
      <div class="gs-card-hd">
        <div class="gs-card-hd-top">
          <div class="gs-card-nombre">Sin grupo asignado</div>
          <span class="gs-card-n">${sinGrupo.length} miembros</span>
        </div>
      </div>
      <div class="gs-miembros" style="max-height:200px">
        ${sinGrupo.sort((a,b)=>a.apellido.localeCompare(b.apellido)).map(p=>`
          <div class="gs-miembro" onclick="verPublicadorDesdeGrupo('${p.id}')">
            <div class="gs-miembro-avatar" style="background:var(--red-lt);color:var(--red)">${(p.apellido[0]||'')+(p.nombre[0]||'')}</div>
            <span class="gs-miembro-nombre">${escHtml(p.apellido)}, ${escHtml(p.nombre)}</span>
          </div>`).join('')}
      </div>
      <div class="gs-card-footer">
        <button class="gs-btn gs-btn-prim" style="flex:1" onclick="abrirModalGrupos()">Asignar grupos →</button>
      </div>
    </div>` : '';

  wrap.innerHTML = `
    <div class="gs-header">
      <div>
        <div class="gs-title">Grupos de Servicio</div>
        <div class="gs-subtitle">${gruposActivos.length} grupos activos · ${mesNombre} ${anio}</div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-ghost" onclick="exportarPlantillaInformes()">↓ Plantilla informes</button>
        <button class="btn btn-ghost" onclick="importarInformes()">↑ Importar informes</button>
        <button class="btn btn-ghost" onclick="abrirModalGrupos()">Gestionar grupos</button>
      </div>
    </div>
    <div class="gs-grid">${tarjetas}</div>
    ${sinGrupoBloque}
  `;
}


function verPublicadorDesdeGrupo(id) {
  irA('publicadores');
  selPub(id);
}

function filtrarYVerGrupo(grupo) {
  irA('publicadores');
  filtrarGrupo(grupo);
}


// GRUPOS
// ══════════════════════════════════════════
const GRUPOS_LISTA = Array.from({length:14},(_,i)=>`Grupo ${i+1}`);
let filtroGrupo = null;

function initGrupos() {
  if(!state.grupos) state.grupos = {};
  // Agregar grupos que faltan sin tocar los que ya tienen datos
  GRUPOS_LISTA.forEach(g => {
    if(!state.grupos[g]) state.grupos[g] = { super:'', aux:'' };
  });
}

function filtrarGrupo(nombre) {
  filtroGrupo = (filtroGrupo === nombre || nombre === null) ? null : nombre;
  filtroTipo = null;
  renderLista();
  document.getElementById('pubList').scrollTop = 0;
}

function renderGruposPanel() {
  initGrupos();
  const el = document.getElementById('gruposPanel');
  if(!el) return;
  // Chips compactos: solo número de grupo + cantidad miembros
  el.innerHTML = GRUPOS_LISTA.map(g => {
    const miembros = state.publicadores.filter(p => p.grupo === g).length;
    const activo = filtroGrupo === g ? ' activo' : '';
    const num = g.replace(/[^0-9]/g,'') || g;
    return `<div class="grupo-chip${activo}" onclick="filtrarGrupo('${g}')" title="${g} · ${miembros} publicadores">
      G${num} <span style="opacity:.65;font-size:10px">${miembros}</span>
    </div>`;
  }).join('');
  // Badge en el toggle
  const badge = document.getElementById('badgeGrupos');
  if(badge) {
    badge.textContent = filtroGrupo ? filtroGrupo.replace(/[^0-9]/g,'') ? 'G'+filtroGrupo.replace(/[^0-9]/g,'') : filtroGrupo : '';
    badge.classList.toggle('visible', !!filtroGrupo);
  }
}


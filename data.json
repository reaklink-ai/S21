// Restaurar sesión si ya estaba autenticado
(function() {
  const _saved = sessionStorage.getItem('s21_user');
  if(_saved) {
    try {
      currentUser = JSON.parse(_saved);
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('appWrap').style.display = 'block';
      document.getElementById('appbar').style.display = 'flex';
      document.getElementById('appLayout').style.display = 'flex';
      const _nav = document.getElementById('mobileNav');
      if(_nav) _nav.style.removeProperty('display');
      if(document.getElementById('appbar-user')) document.getElementById('appbar-user').textContent = currentUser.nombre;
      if(document.getElementById('appbar-rol')) {
        document.getElementById('appbar-rol').textContent = getRolLabel(currentUser.rol);
        document.getElementById('appbar-rol').style.color = getRolColor(currentUser.rol);
      }
      // Primero aplicar permisos, luego ir al inicio
      applyRoleUI();
      irA('inicio');
      // Sincronizar al restaurar sesión
      setTimeout(async () => {
        try {
          const res = await fetch(SYNC_URL + '?t=' + Date.now());
          if(!res.ok) return;
          const json   = await res.json();
          const remoto = json.data;
          const tsLocal  = state._lastModified || 0;
          const tsRemoto = remoto._lastModified || 0;
          const localTieneSupers  = Object.values(state.grupos||{}).some(g=>g.super);
          const remotoTieneSupers = Object.values(remoto.grupos||{}).some(g=>g.super);
          if(tsLocal > tsRemoto || (localTieneSupers && !remotoTieneSupers)) {
            await _mergeAndPush();
          } else {
            state = _mergeStates(state, remoto);
            if(!state.usuarios||state.usuarios.length===0) state.usuarios=[{...DEFAULT_ADMIN}];
            migrarUsuariosLegacy();
            localStorage.setItem(KEY, JSON.stringify(state));
            renderDashboard(); renderLista();
          }
        } catch(e) {}
      }, 500);
    } catch(e) {
      currentUser = null;
      setTimeout(() => document.getElementById('loginUser')?.focus(), 100);
    }
  } else {
    setTimeout(() => document.getElementById('loginUser')?.focus(), 100);
  }
})();


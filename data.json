function importarDatos() { document.getElementById('fileInput').click(); }
function cargarJSON(e) {
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=async ev=>{
    try{
      const d=JSON.parse(ev.target.result);
      if(!d.publicadores) throw 0;
      d._lastModified = Date.now();
      state = d;
      saveState();
      // Restauración completa: subir directo sin merge para no perder datos
      try {
        const res = await fetch(SYNC_URL + '?t=' + Date.now());
        let sha = null;
        if(res.ok){ const j=await res.json(); sha=j.sha||null; _lastSha=sha; }
        const putRes = await fetch(SYNC_URL, {
          method:'PUT',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({data:state, sha})
        });
        if(putRes.ok){ const pj=await putRes.json(); if(pj.sha) _lastSha=pj.sha; toast('✓ Restaurado y sincronizado'); }
        else { toast('Restaurado localmente (error al sincronizar)'); }
      } catch(se){ toast('Restaurado localmente (sin conexión)'); }
      renderLista();
      if(selId&&getPub(selId)) renderS21();
    }catch{ alert('Archivo inválido'); }
  };
  r.readAsText(f); e.target.value='';
}


function importarCSV() { document.getElementById('fileInputCSV').click(); }
function cargarCSV(e) {
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = ev => {
    try {
      let txt = ev.target.result;
      // Remove BOM if present
      if(txt.charCodeAt(0) === 0xFEFF) txt = txt.slice(1);
      const lines = txt.split(/\r?\n/).filter(l => l.trim());
      if(lines.length < 2) { alert('El archivo CSV está vacío'); return; }

      // Parse CSV line respecting quoted fields
      function parseCSVLine(line) {
        const fields = [];
        let cur = '', inQ = false;
        for(let i=0; i<line.length; i++){
          const ch = line[i];
          if(ch==='"' && !inQ){ inQ=true; }
          else if(ch==='"' && inQ){ if(line[i+1]==='"'){cur+='"';i++;} else inQ=false; }
          else if(ch===',' && !inQ){ fields.push(cur); cur=''; }
          else { cur+=ch; }
        }
        fields.push(cur);
        return fields;
      }

      const headers = parseCSVLine(lines[0]).map(h=>h.trim().toLowerCase());

      // Map header names to internal fields
      const idx = {
        apellido:     headers.findIndex(h=>h.includes('apellido')),
        nombre:       headers.findIndex(h=>h==='nombre' || h.includes('nombre')),
        nacimiento:   headers.findIndex(h=>h.includes('nacimiento')),
        bautismo:     headers.findIndex(h=>h.includes('bautismo')),
        grupo:        headers.findIndex(h=>h.includes('grupo')),
        telefono:     headers.findIndex(h=>h.includes('telefono') || h.includes('teléfono')),
        genero:       headers.findIndex(h=>h.includes('genero') || h.includes('género')),
        anciano:      headers.findIndex(h=>h.includes('anciano')),
        siervo:       headers.findIndex(h=>h.includes('siervo')),
        precursorReg: headers.findIndex(h=>h.includes('precursorreg') || (h.includes('precursor')&&h.includes('reg'))),
        precursorEsp: headers.findIndex(h=>h.includes('precursoresp') || (h.includes('precursor')&&h.includes('esp'))),
        misionero:    headers.findIndex(h=>h.includes('misionero')),
        otrasOvejas:  headers.findIndex(h=>h.includes('otras')),
        ungido:       headers.findIndex(h=>h.includes('ungido')),
      };

      function get(fields, key) {
        const i = idx[key];
        return i >= 0 && i < fields.length ? fields[i].trim() : '';
      }
      function bool(v) { return v.toUpperCase()==='SI' || v.toUpperCase()==='Y' || v==='1'; }
      function genId() { return Date.now().toString(36)+Math.random().toString(36).slice(2,6); }

      let nuevos = 0, actualizados = 0, errores = 0;

      for(let i=1; i<lines.length; i++) {
        const fields = parseCSVLine(lines[i]);
        if(fields.every(f=>!f.trim())) continue;

        const apellido = get(fields,'apellido');
        const nombre   = get(fields,'nombre');
        if(!apellido && !nombre) { errores++; continue; }

        // Title-case helper
        const toTitle = s => s ? s.toLowerCase().replace(/\b\w/g, l => l.toUpperCase()) : s;

        const pub = {
          id:          genId(),
          apellido:    toTitle(apellido),
          nombre:      toTitle(nombre),
          nacimiento:  get(fields,'nacimiento'),
          bautismo:    get(fields,'bautismo'),
          grupo:       get(fields,'grupo'),
          telefono:    get(fields,'telefono'),
          genero:      get(fields,'genero') || 'M',
          anciano:     bool(get(fields,'anciano')),
          siervo:      bool(get(fields,'siervo')),
          precursorReg:bool(get(fields,'precursorReg')),
          precursorEsp:bool(get(fields,'precursorEsp')),
          misionero:   bool(get(fields,'misionero')),
          otrasOvejas: bool(get(fields,'otrasOvejas')),
          ungido:      bool(get(fields,'ungido')),
          emergencia:  {},
          registros:   {}
        };

        // Normalize for comparison: lowercase, trim, collapse spaces, remove accents
        const norm = s => (s||'').toLowerCase().trim()
          .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
          .replace(/\s+/g,' ');

        // Check if already exists (same apellido + nombre, normalized)
        const existing = state.publicadores.findIndex(p =>
          norm(p.apellido) === norm(pub.apellido) &&
          norm(p.nombre)   === norm(pub.nombre)
        );
        if(existing >= 0) {
          // Update but preserve registros and emergencia
          pub.id = state.publicadores[existing].id;
          pub.registros = state.publicadores[existing].registros || {};
          pub.emergencia = state.publicadores[existing].emergencia || {};
          state.publicadores[existing] = pub;
          actualizados++;
        } else {
          state.publicadores.push(pub);
          nuevos++;
        }
      }

      saveStateAndSync();
      renderLista();
      if(selId && getPub(selId)) renderS21();
      toast(`CSV importado: ${nuevos} nuevos, ${actualizados} actualizados${errores?', '+errores+' omitidos':''}`);
    } catch(err) {
      alert('Error al leer el CSV: ' + err.message);
    }
  };
  r.readAsText(f, 'UTF-8');
  e.target.value = '';
}

function exportarTxt() {
  const pub=getPub(selId); if(!pub) return;
  let txt='REGISTRO DE PUBLICADOR DE LA CONGREGACIÓN\n';
  txt+='S-21-S\n'+'='.repeat(60)+'\n';
  txt+=`Nombre: ${pub.apellido}, ${pub.nombre}\n`;
  txt+=`Fecha nacimiento: ${pub.nacimiento||'—'}   Bautismo: ${pub.bautismo||'—'}\n`;
  txt+=`${pub.genero==='M'?'[X] Hombre  [ ] Mujer':'[ ] Hombre  [X] Mujer'}   `;
  txt+=`${pub.otrasOvejas?'[X]':'[ ]'} Otras ovejas  ${pub.ungido?'[X]':'[ ]'} Ungido\n`;
  txt+=`${pub.anciano?'[X]':'[ ]'} Anciano  ${pub.siervo?'[X]':'[ ]'} Siervo ministerial  ${pub.precursorReg?'[X]':'[ ]'} Precursor regular  ${pub.precursorEsp?'[X]':'[ ]'} Precursor especial  ${pub.misionero?'[X]':'[ ]'} Misionero\n\n`;
  txt+=`AÑO DE SERVICIO: ${anioVer} — ${anioVer+1}\n${'─'.repeat(60)}\n`;
  txt+=`MES              PARTICIP.  C.BÍBL.  P.AUX  HORAS    NOTAS\n${'─'.repeat(60)}\n`;
  let tH=0,tC=0,tP=0,tPA=0;
  MESES.forEach((mes,i)=>{
    const m=MESES_C[i], r=getReg(pub,anioVer,m);
    if(r.particip)tP++; if(r.paux)tPA++;
    tH+=parseFloat(r.horas)||0; tC+=parseInt(r.cursos)||0;
    txt+=`${mes.padEnd(16)} ${(r.particip?'Sí':'').padEnd(10)} ${(r.cursos||'').padEnd(8)} ${(r.paux?'Sí':'').padEnd(6)} ${(r.horas||'').padEnd(8)} ${r.notas||''}\n`;
  });
  txt+=`${'─'.repeat(60)}\nTotal            ${String(tP).padEnd(10)} ${String(tC).padEnd(8)} ${String(tPA).padEnd(6)} ${tH%1===0?tH:tH.toFixed(1)}\n`;
  const b=new Blob([txt],{type:'text/plain;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(b);
  a.download=`S21_${pub.apellido}_${pub.nombre}_${anioVer}.txt`; a.click();
  toast('Exportado ✓');
}

function toast(msg, dur=2200) {
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), dur);
}


// EXPORTAR PLANTILLA CSV
// ══════════════════════════════════════════
function exportarPlantillaCSV() {
  const headers = [
    'apellido','nombre','nacimiento (AAAA-MM-DD)','bautismo (AAAA-MM-DD)',
    'grupo','telefono','genero (M/F)',
    'anciano (SI/NO)','siervo (SI/NO)',
    'precursorReg (SI/NO)','precursorEsp (SI/NO)','misionero (SI/NO)',
    'otrasOvejas (SI/NO)','ungido (SI/NO)'
  ];
  const ejemplo = [
    'García López','Ana María','1990-05-15','2010-03-20',
    'Grupo 1','310 000 0000','F',
    'NO','NO','SI','NO','NO','SI','NO'
  ];
  const ejemplo2 = [
    'Martínez','Pedro José','1985-11-02','2005-07-10',
    'Grupo 2','315 111 2222','M',
    'SI','NO','NO','NO','NO','SI','NO'
  ];

  const bom = '﻿'; // BOM para Excel en español
  const csv = bom + [headers, ejemplo, ejemplo2]
    .map(row => row.map(v => `"${String(v).replace(/"/g,'""')}"`).join(','))
    .join('\r\n');

  const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = 'plantilla_importar_publicadores.csv';
  a.click();
  URL.revokeObjectURL(url);
  toast('Plantilla CSV descargada');
}


// ─── APPBAR MENU ───
function toggleMenu(id) {
  const el = document.getElementById(id);
  const isOpen = el.classList.contains('open');
  closeMenus();
  if(!isOpen) el.classList.add('open');
}
function closeMenus() {
  document.querySelectorAll('.ab-menu.open').forEach(m => m.classList.remove('open'));
}
document.addEventListener('click', function(e) {
  if(!e.target.closest('.ab-menu')) closeMenus();
});



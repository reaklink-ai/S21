    { id:'p3',  nombre:'Busquemos perlas escondidas',             mins:10,   seccion:'tesoros',  doble:false, rol:'anciano_siervo' },
    { id:'p4',  nombre:'Lectura de la Biblia',                    detalle:'',  mins:4,    seccion:'tesoros',  doble:true,  rol:'todos' },
    { id:'p5',  nombre:'Empiece conversaciones',                  detalle:'',  mins:3,    seccion:'maestros', doble:true,  rol:'todos', conAyudante:true },

<script>
// ══════════════════════════════════════════
// DATOS
// ══════════════════════════════════════════
const KEY = 's21_v3';

// ── GitHub Sync Config ──
// ── Sync: apunta al Worker de Cloudflare (el token vive allá, no aquí) ──
const SYNC_URL = 'https://mute-grass-cc8b.reaklink.workers.dev/sync';

// ══════════════════════════════════════════
//  ROLES Y USUARIOS
// ══════════════════════════════════════════
// Roles: admin | secretario | anciano | lector
// Los usuarios y contraseñas se guardan en state.usuarios
// Usuario admin por defecto (solo si no hay ninguno)
const DEFAULT_ADMIN = { id:'admin', nombre:'Administrador', pin:'4535', rol:'admin', grupo:null };
// admin123 → 240be518... | secretario123 → e9cee71ab932fde863338d08be4de9dfe39ea049bdafb342ce659ec5450b69ae

let currentUser = null; // usuario logueado

function getRolLabel(rol) {
  return {admin:'Administrador',secretario:'Secretario',anciano:'Anciano',lector:'Solo lectura'}[rol] || rol;
}
function getRolColor(rol) {
  return {admin:'#1a3fcb',secretario:'#1a6b3c',anciano:'#b45309',lector:'#64748b'}[rol] || '#64748b';
}

// Permisos por rol
const PERMS = {
  admin:      { editarTodo:true,  borrar:true,  exportar:true,  verEmerg:true,  soloGrupo:false, asistencia:true  },
  secretario: { editarTodo:true,  borrar:false, exportar:true,  verEmerg:true,  soloGrupo:false, asistencia:true  },
  anciano:    { editarTodo:false, borrar:false, exportar:false, verEmerg:false, soloGrupo:true,  asistencia:false, vym:true },
  lector:     { editarTodo:false, borrar:false, exportar:false, verEmerg:false, soloGrupo:false, asistencia:false },
};
function can(perm) {
  if(!currentUser) return false;
  return !!(PERMS[currentUser.rol]?.[perm]);
}
function canEdit() { return can('editarTodo') || can('soloGrupo'); }

// Chequear si el usuario tiene acceso a una sección
// Usa campo 'accesos' del usuario si existe, si no usa defaults por rol
function puedeVerSeccion(seccion) {
  if(!currentUser) return false;
  const rol = currentUser.rol;
  if(rol === 'admin' || rol === 'secretario') return true; // ven todo
  // Si tiene accesos personalizados, usarlos
  if(currentUser.accesos && typeof currentUser.accesos[seccion] !== 'undefined') {
    return !!currentUser.accesos[seccion];
  }
  // Defaults por rol
  const defaults = {
    anciano: { publicadores:true, grupos:true, vym:true, metricas:false, datos:false, inactivos:false },
    lector:  { publicadores:true, grupos:true, vym:false, metricas:false, datos:false, inactivos:false },
  };
  return !!(defaults[rol] && defaults[rol][seccion]);
}
function canEditPub(pub) {
  if(!currentUser) return false;
  if(can('editarTodo')) return true;
  if(can('soloGrupo') && pub && pub.grupo === currentUser.grupo) return true;
  return false;
}


const MESES = ['Septiembre','Octubre','Noviembre','Diciembre','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto'];
const MESES_C = ['Sep','Oct','Nov','Dic','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago'];

const TIPO_COLOR = {
  'Anciano':'#1d4ed8','Siervo ministerial':'#15803d',
  'Precursor regular':'#92400e','Precursor especial':'#6d28d9',
  'Misionero en el campo':'#be185d','Publicador':'#64748b'
};

let state = { publicadores:[] };
let selId = null;
let anioVer = anioHoy();
let filtroTipo = null; // null = todos

function anioHoy() {
  const m = new Date().getMonth(), a = new Date().getFullYear();
  return m >= 8 ? a : a - 1;
}

function cargarState() {
  try {
    const r = localStorage.getItem(KEY);
    if(r) {
      state = JSON.parse(r);
      migrarUsuariosLegacy();
    }
  } catch(e) {}
}
function saveState() {
  state._lastModified = Date.now();
  localStorage.setItem(KEY, JSON.stringify(state));
}

// ── Sync via Worker ──
let _syncQueue = Promise.resolve();
let _lastSha   = null; // SHA cacheado para reducir llamadas

function saveStateAndSync() {
  saveState();
  _syncQueue = _syncQueue.then(() => _mergeAndPush()).catch(() => {});
}

async function _mergeAndPush(intentos = 0) {
  try {
    // 1. Descargar versión remota fresca via Worker (GET /sync)
    const res = await fetch(SYNC_URL + '?t=' + Date.now());
    let remoto = null, sha = null;
    if(res.ok) {
      const json = await res.json();
      remoto = json.data || null;
      sha    = json.sha  || null;
      _lastSha = sha;
    } else if(res.status !== 404) {
      throw new Error('Error al leer remoto: ' + res.status);
    }

    // 2. Mezclar: local gana en sus cambios, preserva cambios remotos no tocados
    const merged = remoto ? _mergeStates(remoto, state) : JSON.parse(JSON.stringify(state));
    merged._lastModified = Date.now();

    // 3. PUT via Worker (/sync) con SHA fresco
    const putRes = await fetch(SYNC_URL, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: merged, sha })
    });

    if(putRes.ok) {
      const putJson = await putRes.json();
      if(putJson.sha) _lastSha = putJson.sha;
      state = merged;
      saveState();
      toast('✓ Datos sincronizados');
      return;
    }

    const err = await putRes.json().catch(() => ({}));
    const esConflicto = putRes.status === 409 || putRes.status === 422 ||
      (err.error && err.error.includes('does not match'));
    if(esConflicto && intentos < 4) {
      await new Promise(r => setTimeout(r, 500 * (intentos + 1)));
      return _mergeAndPush(intentos + 1);
    }
    toast('Error al sincronizar: ' + (err.error || putRes.status));
  } catch(e) {
    if(intentos < 2) { await new Promise(r => setTimeout(r, 1000)); return _mergeAndPush(intentos + 1); }
    toast('Error de conexión al sincronizar');
  }
}

// Mezcla inteligente: preserva cambios de ambos lados
function _mergeStates(remoto, local) {
  const m = JSON.parse(JSON.stringify(local));

  // Publicadores: agregar los del remoto que local no tiene
  const localIds = new Set((local.publicadores||[]).map(p=>p.id));
  (remoto.publicadores||[]).forEach(rp => {
    if(!localIds.has(rp.id)) { m.publicadores.push(rp); return; }
    const lp = m.publicadores.find(p=>p.id===rp.id);
    if(!lp) return;
    Object.entries(rp.registros||{}).forEach(([anio, meses]) => {
      if(!lp.registros) lp.registros = {};
      if(!lp.registros[anio]) lp.registros[anio] = {};
      Object.entries(meses||{}).forEach(([mes, val]) => {
        if(!lp.registros[anio][mes]) lp.registros[anio][mes] = val;
      });
    });
  });

  // Grupos: preservar asignaciones remotas que local no tiene
  Object.entries(remoto.grupos||{}).forEach(([g, cfg]) => {
    if(!m.grupos) m.grupos = {};
    if(!m.grupos[g]) { m.grupos[g] = cfg; return; }
    if(!m.grupos[g].super && cfg.super) m.grupos[g].super = cfg.super;
    if(!m.grupos[g].aux   && cfg.aux)   m.grupos[g].aux   = cfg.aux;
  });

  // Asistencia: agregar registros remotos que local no tiene (por ID)
  const localAIds = new Set((local.asistencia||[]).map(r=>r.id));
  (remoto.asistencia||[]).forEach(r => { if(!localAIds.has(r.id)) m.asistencia.push(r); });

  // VyM: agregar semanas remotas que local no tiene; preservar asignaciones locales
  if(remoto.vym && remoto.vym.semanas) {
    if(!m.vym) m.vym = { semanas: {} };
    Object.entries(remoto.vym.semanas).forEach(([k, sv]) => {
      if(!m.vym.semanas[k]) { m.vym.semanas[k] = sv; return; }
      // Preservar asignaciones: local gana sobre remoto en asign
      if(sv.partes && !m.vym.semanas[k].partes) m.vym.semanas[k].partes = sv.partes;
      if(sv.libros && !m.vym.semanas[k].libros) m.vym.semanas[k].libros = sv.libros;
    });
  }

  return m;
}

async function ghPush() { return _mergeAndPush(); }

async function ghPull() {
  try {
    const res = await fetch(SYNC_URL + '?t=' + Date.now());
    if(res.status === 404) { toast('No hay datos en la nube aún'); return; }
    if(!res.ok) { toast('Error al conectar con el servidor'); return; }
    const json  = await res.json();
    const remoto = json.data;
    _lastSha = json.sha;

    const tsLocal  = state._lastModified || 0;
    const tsRemoto = remoto._lastModified || 0;

    if(tsLocal > tsRemoto) {
      toast('Sincronizando cambios locales...');
      await _mergeAndPush();
      return;
    }

    state = _mergeStates(state, remoto);
    if(!state.usuarios || state.usuarios.length === 0) state.usuarios = [{ ...DEFAULT_ADMIN }];
    migrarUsuariosLegacy();
    localStorage.setItem(KEY, JSON.stringify(state));
    selId = null;
    renderDashboard();
    renderLista();
    toast('✓ Datos actualizados');
  } catch(e) { toast('Error al cargar: ' + e.message); }
}


function getPub(id) { return state.publicadores.find(p=>p.id===id); }

function tipoPrincipal(p) {
  if(p.misionero) return 'Misionero en el campo';
  if(p.precursorEsp) return 'Precursor especial';
  if(p.precursorReg) return 'Precursor regular';
  if(p.anciano) return 'Anciano';
  if(p.siervo) return 'Siervo ministerial';
  return 'Publicador';
}

function getReg(pub, anio, mes) {
  if(!pub.registros) pub.registros={};
  if(!pub.registros[anio]) pub.registros[anio]={};
  if(!pub.registros[anio][mes]) pub.registros[anio][mes]={particip:false,cursos:'',paux:false,horas:'',notas:''};
  return pub.registros[anio][mes];
}

// ══════════════════════════════════════════
// LISTA
// ══════════════════════════════════════════
function renderLista() {
  const q = document.getElementById('searchBox').value.toLowerCase().trim();
  const esAnciano = currentUser && currentUser.rol === 'anciano' && currentUser.grupo;

  // Filtro base — búsqueda por nombre, apellido o grupo
  let lista = state.publicadores.filter(p => {
    const haystack = (p.apellido+' '+p.nombre+' '+(p.grupo||'')).toLowerCase();
    return !q || haystack.includes(q);
  });
  if(esAnciano) {
    lista = lista.filter(p => p.grupo === currentUser.grupo);
  } else if(filtroGrupo) {
    lista = lista.filter(p => p.grupo === filtroGrupo);
  } else if(filtroTipo) {
    if(filtroTipo==='publicador')
      lista = lista.filter(p=>!p.anciano&&!p.siervo&&!p.precursorReg&&!p.precursorEsp&&!p.misionero);
    else
      lista = lista.filter(p=>!!p[filtroTipo]);
  }
  lista = lista.sort((a,b)=>a.apellido.localeCompare(b.apellido,'es'));

  // Contadores
  const pubsBase = esAnciano ? state.publicadores.filter(p=>p.grupo===currentUser.grupo) : state.publicadores;
  document.getElementById('statTotal').textContent = pubsBase.length;
  const grupos = new Set(pubsBase.map(p=>p.grupo).filter(Boolean));
  document.getElementById('statGrupos').textContent = grupos.size;

  renderStats();
  renderGruposPanel();

  // Chip de filtro activo
  const TIPO_LABELS = {
    anciano:'Ancianos', siervo:'Siervos ministeriales',
    precursorReg:'Precursores regulares', precursorEsp:'Precursores especiales',
    misionero:'Misioneros', publicador:'Publicadores'
  };
  const chipEl = document.getElementById('filtroChip');
  const chipLabel = document.getElementById('filtroChipLabel');
  if(filtroGrupo && chipEl) {
    chipEl.style.display='flex';
    chipLabel.textContent = filtroGrupo;
  } else if(filtroTipo && chipEl) {
    chipEl.style.display='flex';
    chipLabel.textContent = TIPO_LABELS[filtroTipo]||filtroTipo;
  } else if(chipEl) {
    chipEl.style.display='none';
  }

  // Badge sección privilegios
  const badgePriv = document.getElementById('badgePriv');
  if(badgePriv) {
    const lbl = filtroTipo && !filtroGrupo ? (TIPO_LABELS[filtroTipo]||filtroTipo) : '';
    badgePriv.textContent = lbl;
    badgePriv.classList.toggle('visible', !!lbl);
  }

  // Resaltar priv-item activo
  ['anciano','siervo','precursorReg','precursorEsp','misionero','publicador'].forEach(k=>{
    const el=document.getElementById('sr-'+k);
    if(el) el.classList.toggle('activo', k===filtroTipo && !filtroGrupo);
  });

  const el = document.getElementById('pubList');
  if(!lista.length){
    el.innerHTML='<div style="padding:24px;text-align:center;color:#aaa;font-size:12px;">Sin resultados</div>';
    renderAlphaIndex([]);
    return;
  }

  // Agrupar por letra inicial del apellido
  const letrasPresentes = new Set();
  const grupos_alfa = {};
  lista.forEach(pub => {
    const letra = pub.apellido[0]?.toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g,'') || '#';
    letrasPresentes.add(letra);
    if(!grupos_alfa[letra]) grupos_alfa[letra] = [];
    grupos_alfa[letra].push(pub);
  });

  // Render con cabeceras alfabéticas
  el.innerHTML = Object.keys(grupos_alfa).sort().map(letra => {
    const items = grupos_alfa[letra].map(pub => {
      const tipo=tipoPrincipal(pub), col=TIPO_COLOR[tipo]||'#64748b';
      const init=(pub.apellido[0]||'')+(pub.nombre[0]||'');
      const sel=pub.id===selId?' sel':'';
      return `<div class="pub-item${sel}" id="pub-${pub.id}" onclick="selPub('${pub.id}')">
        <div class="pub-av" style="background:${col}18;color:${col}">${init}</div>
        <div class="pub-item-info">
          <div class="pub-item-name">${escHtml(pub.apellido)}, ${escHtml(pub.nombre)}</div>
          <div class="pub-item-sub">${escHtml(pub.grupo||'Sin grupo')}</div>
        </div>
        <div class="pub-badge" style="background:${col}20;color:${col}">${tipo.split(' ')[0]}</div>
      </div>`;
    }).join('');
    return `<div class="pub-alpha-header" id="alpha-${letra}">${letra}</div>${items}`;
  }).join('');

  renderAlphaIndex([...letrasPresentes]);
}

function renderAlphaIndex(letrasPresentes) {
  const idx = document.getElementById('alphaIndex');
  if(!idx) return;
  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
  const set = new Set(letrasPresentes);
  idx.innerHTML =
    `<button class="alpha-btn has-items" onclick="pubListScrollTop()" title="Inicio" style="font-size:11px">↑</button>` +
    letras.map(l =>
      `<button class="alpha-btn${set.has(l)?' has-items':''}" onclick="scrollToLetra('${l}')">${l}</button>`
    ).join('');
}

function scrollToLetra(letra) {
  const list = document.getElementById('pubList');
  const header = document.getElementById('alpha-'+letra);
  if(header && list) {
    list.scrollTo({top: header.offsetTop - 2, behavior:'smooth'});
  }
  document.querySelectorAll('.alpha-btn').forEach(b => b.classList.toggle('active', b.textContent===letra));
  setTimeout(()=>document.querySelectorAll('.alpha-btn').forEach(b=>b.classList.remove('active')), 1200);
}

function pubListScrollTop() {
  const list = document.getElementById('pubList');
  if(list) list.scrollTo({top:0, behavior:'smooth'});
}

function onPubListScroll() {
  const list = document.getElementById('pubList');
  const btn = document.getElementById('scrollTopBtn');
  if(!list || !btn) return;
  btn.classList.toggle('visible', list.scrollTop > 150);
}

// ══════════════════════════════════════════
// RENDER S-21
// ══════════════════════════════════════════
function selPub(id) {
  selId=id; anioVer=anioHoy(); renderLista(); renderS21();
  // En móvil: ocultar panel, mostrar main
  if(window.innerWidth <= 767) {
    const panel = document.getElementById('panelLista');
    if(panel) panel.classList.add('panel-hidden');
  }
}

function renderS21() {
  const pub = getPub(selId);
  if(!pub) return;

  // Totales
  let tH=0,tC=0,tP=0,tPA=0;
  MESES_C.forEach((m,i)=>{
    const r=getReg(pub,anioVer,m);
    if(r.particip) tP++;
    if(r.paux) tPA++;
    tH += parseFloat(r.horas)||0;
    tC += parseInt(r.cursos)||0;
  });

  // Checkbox oficial (cuadrado simple)
  const chk=(label,checked)=>`<span class="s21-chk${checked?' chk-on':''}">
    <input type="checkbox" ${checked?'checked':''} disabled>
    <div class="s21-box">${checked?'✓':''}</div>${label}</span>`;

  // Filas mensuales
  const filas = MESES_C.map((mes,i)=>{
    const r=getReg(pub,anioVer,mes);
    const anioFila = i<4 ? anioVer : anioVer+1;
    return `<tr>
      <td><div class="td-mes-label">${MESES[i]} <span class="td-mes-anio">${anioFila}</span></div></td>
      <td>
        <div class="td-chk" onclick="toggleBool('${pub.id}',${anioVer},'${mes}','particip')">
          <div class="td-chk-box${r.particip?' on':''}">${r.particip?'✓':''}</div>
        </div>
      </td>
      <td><input class="td-input" type="number" min="0" max="99" value="${r.cursos||''}" placeholder="—" onchange="setV('${pub.id}',${anioVer},'${mes}','cursos',this.value)"></td>
      <td>
        <div class="td-chk" onclick="toggleBool('${pub.id}',${anioVer},'${mes}','paux')">
          <div class="td-chk-box${r.paux?' paux-on':''}">${r.paux?'✓':''}</div>
        </div>
      </td>
      <td><input class="td-input" type="number" min="0" step="0.5" value="${r.horas||''}" placeholder="—" onchange="setV('${pub.id}',${anioVer},'${mes}','horas',this.value)"></td>
      <td class="td-notas"><input type="text" value="${escHtml(r.notas||'')}" placeholder="" onchange="setV('${pub.id}',${anioVer},'${mes}','notas',this.value)"></td>
    </tr>`;
  }).join('');

  const totalHStr = tH%1===0 ? (tH||'') : tH.toFixed(1);
  const isMobile = window.innerWidth <= 767;

  document.getElementById('mainArea').innerHTML = `
  <div class="s21-doc">

    <!-- Barra de acciones -->
    <div class="s21-toolbar">
      ${isMobile?`<button onclick="volverLista()" class="s21-toolbar-btn">← Lista</button>`:''}
      <span class="s21-toolbar-name">${escHtml(pub.apellido)}, ${escHtml(pub.nombre)}</span>
      <button class="s21-toolbar-btn edit" onclick="abrirModalEditar('${pub.id}')" style="display:${canEditPub(pub)?'':'none'}">Editar</button>
      <button class="s21-toolbar-btn" style="background:rgba(192,57,43,.15);border-color:rgba(192,57,43,.3);color:#fca5a5;display:${can('editarTodo')?'':'none'}" onclick="moverAInactivos('${pub.id}')">Sacar</button>
    </div>

    <!-- Formulario oficial -->
    <div class="s21-form">
      <div class="s21-form-title">Registro de Publicador de la Congregación</div>

      <!-- Fila: Nombre -->
      <div class="s21-info-row">
        <div class="s21-info-cell" style="min-width:130px">
          <span class="s21-info-label">Nombre:</span>
        </div>
        <div class="s21-info-cell grow">
          <span class="s21-info-name">${escHtml(pub.apellido+', '+pub.nombre)}</span>
        </div>
      </div>

      <!-- Fila: Nacimiento + Hombre/Mujer -->
      <div class="s21-info-row">
        <div class="s21-info-cell" style="min-width:130px">
          <span class="s21-info-label">Fecha de nacimiento:</span>
        </div>
        <div class="s21-info-cell grow">
          <span class="s21-info-val">${pub.nacimiento||''}</span>
        </div>
        <div class="s21-info-cell" style="gap:16px">
          ${chk('Hombre', pub.genero==='M')}
          ${chk('Mujer', pub.genero==='F')}
        </div>
      </div>

      <!-- Fila: Bautismo + Otras ovejas/Ungido -->
      <div class="s21-info-row">
        <div class="s21-info-cell" style="min-width:130px">
          <span class="s21-info-label">Fecha de bautismo:</span>
        </div>
        <div class="s21-info-cell grow">
          <span class="s21-info-val">${pub.bautismo||''}</span>
        </div>
        <div class="s21-info-cell" style="gap:16px">
          ${chk('Otras ovejas', !!pub.otrasOvejas)}
          ${chk('Ungido', !!pub.ungido)}
        </div>
      </div>

      <!-- Fila: Privilegios -->
      <div class="s21-info-row" style="border-bottom:1px solid #999">
        <div class="s21-info-cell" style="flex:1;flex-wrap:wrap;gap:10px 20px;padding:7px 10px">
          ${chk('Anciano', !!pub.anciano)}
          ${chk('Siervo ministerial', !!pub.siervo)}
          ${chk('Precursor regular', !!pub.precursorReg)}
          ${chk('Precursor especial', !!pub.precursorEsp)}
          ${chk('Misionero que sirve en el campo', !!pub.misionero)}
        </div>
      </div>
    </div>

    <!-- Navegador de año -->
    <div class="s21-anio-bar">
      <button class="anio-nav-btn" onclick="cambiarAnio(-1)">◀</button>
      <span class="anio-lbl">Año de servicio: ${anioVer} — ${anioVer+1}</span>
      <button class="anio-nav-btn" onclick="cambiarAnio(1)">▶</button>
      <div class="s21-actions">
        <button class="s21-act-btn" onclick="exportarTxt()">↓ Exportar TXT</button>
        <button class="s21-act-btn" onclick="window.print()">⎙ Imprimir</button>
      </div>
    </div>

    <!-- Tabla mensual -->
    <div style="padding:0 20px 4px">
    <div class="s21-table-wrap">
    <table class="s21-tabla">
      <thead>
        <tr>
          <th style="min-width:120px;text-align:left">Año de servicio</th>
          <th style="width:90px">Participación<br>en el<br>ministerio</th>
          <th style="width:80px">Cursos<br>bíblicos</th>
          <th style="width:80px">Precursor<br>auxiliar</th>
          <th style="width:100px">Horas<br><span style="font-size:9px;font-weight:400">(Si es precursor o<br>misionero que<br>sirve en el campo)</span></th>
          <th>Notas</th>
        </tr>
      </thead>
      <tbody>${filas}</tbody>
      <tfoot>
        <tr>
          <td colspan="3" class="tf-label">Total</td>
          <td class="total-p">${tPA||''}</td>
          <td class="total-h">${totalHStr}</td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    </div>
    </div>

  </div>

  ${renderEmergCard(pub)}`;
}


function renderEmergCard(pub) {
  const e = pub.emergencia||{};
  const hayDatos = e.nombre||e.tel||e.direccion;
  if(!hayDatos) return `
  <div class="emerg-card" style="border-style:dashed;opacity:0.5">
    <div class="emerg-title-bar" style="background:#555;">Sin datos de emergencia — <span style="font-weight:400;font-style:italic;font-size:10px">Editar publicador para agregar</span></div>
  </div>`;

  const cel=(label,val)=>{
    const vacio=!val;
    return `<div class="emerg-cell"><div class="emerg-cell-label">${label}</div><div class="emerg-cell-val${vacio?' vacio':''}">${vacio?'—':escHtml(val)}</div></div>`;
  };
  return `
  <div class="emerg-card">
    <div class="emerg-title-bar">Datos de emergencia</div>
    <div class="emerg-grid">
      ${cel('Contacto de emergencia', e.nombre)}
      ${cel('Parentesco', e.relacion)}
      ${cel('Teléfono', e.tel)}
      ${cel('Tel. alternativo', e.tel2)}
      ${cel('Dirección', e.direccion)}
      ${cel('Notas médicas', e.notasMed)}
    </div>
  </div>`;
}

function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ══════════════════════════════════════════
// ACCIONES CELDA
// ══════════════════════════════════════════
function toggleBool(pid,anio,mes,campo) {
  const pub=getPub(pid), r=getReg(pub,anio,mes);
  r[campo]=!r[campo];
  saveStateAndSync(); renderS21();
}

function setV(pid,anio,mes,campo,val) {
  const pub=getPub(pid), r=getReg(pub,anio,mes);
  r[campo]=val;
  saveStateAndSync(); actualizarTotales(pub,anio);
}

function actualizarTotales(pub,anio) {
  let tH=0,tC=0,tP=0,tPA=0;
  MESES_C.forEach(m=>{ const r=getReg(pub,anio,m); if(r.particip)tP++; if(r.paux)tPA++; tH+=parseFloat(r.horas)||0; tC+=parseInt(r.cursos)||0; });
  const tds=document.querySelectorAll('table.s21-tabla tfoot td');
  if(tds.length>=4){ tds[1].textContent=tPA; const s=tH%1===0?tH:tH.toFixed(1); tds[2].textContent=s>0?s:'—'; }
}

function cambiarAnio(d) { anioVer+=d; renderS21(); }

// ══════════════════════════════════════════
// ASISTENCIA
// ══════════════════════════════════════════
// ══════════════════════════════════════════
// ASISTENCIA — PANTALLA COMPLETA
// ══════════════════════════════════════════
let asistChartFilter = 'todos';
let asistRecordFilter = 'todos';

function toggleAsistencia() { irA('asistencia'); } // compatibilidad botones viejos
function cerrarAsistencia() {}

function setChartFilter(val, btn) {
  asistChartFilter = val;
  document.querySelectorAll('#asistChartTabs .asist-chart-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderAsistenciaChart();
}

function setRecordFilter(val, btn) {
  asistRecordFilter = val;
  document.querySelectorAll('#asistFilterRow .asist-filter-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderAsistenciaTabla();
}

function autoTemaReunion(tipo) {
  const temas = {
    'Entre semana': 'Vida y Ministerio Cristiano',
    'Fin de semana': 'Estudio de la Atalaya',
  };
  const campo = document.getElementById('aTema');
  if(!campo) return;
  const valorActual = campo.value.trim();
  // Solo sobreescribir si está vacío o es uno de los temas por defecto
  const esDefault = Object.values(temas).includes(valorActual) || valorActual === '';
  if(esDefault) campo.value = temas[tipo] || '';
}

function agregarReunion() {
  const fecha = document.getElementById('aFecha').value;
  if(!fecha){ alert('Selecciona una fecha'); return; }
  if(!state.asistencia) state.asistencia = [];
  const presencial = parseInt(document.getElementById('aPresencial').value)||0;
  const zoom       = parseInt(document.getElementById('aZoom').value)||0;
  const reg = {
    id: 'r'+Date.now(),
    fecha,
    tipo:      document.getElementById('aTipo').value,
    tema:      document.getElementById('aTema').value.trim(),
    presencial,
    zoom,
    total:     presencial + zoom,
    notas:     document.getElementById('aNotas').value.trim(),
  };
  state.asistencia.push(reg);
  state.asistencia.sort((a,b) => b.fecha.localeCompare(a.fecha));
  saveStateAndSync();
  ['aFecha','aTema','aPresencial','aZoom','aNotas'].forEach(id => {
    const el = document.getElementById(id); if(el) el.value = '';
  });
  renderAsistenciaScreen();
  toast('Reunión registrada ✓');
}

function eliminarReunion(id) {
  if(!confirm('¿Eliminar este registro?')) return;
  state.asistencia = (state.asistencia||[]).filter(r => r.id !== id);
  saveStateAndSync(); renderAsistenciaScreen(); toast('Eliminado');
}

function renderAsistenciaScreen() {
  renderAsistenciaMetrics();
  renderAsistenciaByTipo();
  renderAsistenciaChart();
  renderAsistenciaTabla();
  // Inicializar tema por defecto según tipo seleccionado
  setTimeout(() => {
    const sel = document.getElementById('aTipo');
    if(sel) autoTemaReunion(sel.value);
  }, 50);
}

function renderAsistenciaMetrics() {
  const el = document.getElementById('asistMetrics'); if(!el) return;
  const lista = state.asistencia||[];
  const sub   = document.getElementById('asistPageSub');

  const totalR   = lista.length;
  const presTotal= lista.reduce((s,r)=>s+r.presencial,0);
  const zoomTotal= lista.reduce((s,r)=>s+r.zoom,0);
  const genTotal = presTotal + zoomTotal;
  const promedio = totalR ? Math.round(genTotal/totalR) : 0;

  // Tendencia: comparar últimas 4 vs las 4 anteriores
  const ultimas4 = lista.slice(0,4);
  const ant4     = lista.slice(4,8);
  const avgUlt   = ultimas4.length ? Math.round(ultimas4.reduce((s,r)=>s+r.total,0)/ultimas4.length) : 0;
  const avgAnt   = ant4.length     ? Math.round(ant4.reduce((s,r)=>s+r.total,0)/ant4.length)        : 0;
  const diff     = avgUlt - avgAnt;
  const trendHtml = ant4.length ? `<div class="asist-met-trend ${diff>=0?'up':'dn'}">${diff>=0?'▲':'▼'} ${Math.abs(diff)} vs período anterior</div>` : '';

  const maxTotal = lista.length ? Math.max(...lista.map(r=>r.total)) : 0;
  const minTotal = lista.filter(r=>r.total>0).length ? Math.min(...lista.filter(r=>r.total>0).map(r=>r.total)) : 0;

  if(sub) sub.textContent = `${totalR} reunión${totalR!==1?'es':''} registrada${totalR!==1?'s':''}`;

  el.innerHTML = `
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:var(--accent-lt)"><svg width="14" height="14" fill="none" stroke="var(--accent)" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
      <div class="asist-met-n">${totalR}</div>
      <div class="asist-met-l">Reuniones</div>
    </div>
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:var(--accent-lt)"><svg width="14" height="14" fill="none" stroke="var(--accent)" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-4 4"/></svg></div>
      <div class="asist-met-n">${promedio}</div>
      <div class="asist-met-l">Promedio</div>
      ${trendHtml}
    </div>
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:#eff6ff"><svg width="14" height="14" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
      <div class="asist-met-n">${presTotal}</div>
      <div class="asist-met-l">Presencial</div>
    </div>
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:#f5f3ff"><svg width="14" height="14" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
      <div class="asist-met-n">${zoomTotal}</div>
      <div class="asist-met-l">Zoom / remoto</div>
    </div>
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:var(--green-lt)"><svg width="14" height="14" fill="none" stroke="var(--green)" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
      <div class="asist-met-n">${maxTotal}</div>
      <div class="asist-met-l">Máxima</div>
    </div>
    <div class="asist-met-card">
      <div class="asist-met-card-ico" style="background:var(--amber-lt)"><svg width="14" height="14" fill="none" stroke="var(--amber)" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg></div>
      <div class="asist-met-n">${minTotal||'—'}</div>
      <div class="asist-met-l">Mínima</div>
    </div>`;
}

function renderAsistenciaByTipo() {
  const el = document.getElementById('asistByTipo'); if(!el) return;
  const lista = state.asistencia||[];
  const tipos = ['Entre semana','Fin de semana'];
  const colores = { 'Entre semana':'#4f46e5', 'Fin de semana':'#16a34a' };

  const stats = tipos.map(t => {
    const sub = lista.filter(r => r.tipo === t);
    const prom = sub.length ? Math.round(sub.reduce((s,r)=>s+r.total,0)/sub.length) : 0;
    const max  = sub.length ? Math.max(...sub.map(r=>r.total)) : 0;
    return { t, sub, prom, max };
  });
  const maxProm = Math.max(...stats.map(s=>s.prom), 1);

  el.innerHTML = `<div class="asist-tipo-cards">${stats.map(s => `
    <div class="asist-tipo-card" style="--tc-color:${colores[s.t]}">
      <div class="asist-tipo-card-hd">
        <span class="asist-tipo-card-label">${s.t}</span>
        <span class="asist-tipo-reuniones">${s.sub.length} reunión${s.sub.length!==1?'es':''}</span>
      </div>
      <div class="asist-tipo-card-n">${s.prom} <span>promedio</span></div>
      <div class="asist-tipo-bar-bg">
        <div class="asist-tipo-bar-fg" style="width:${Math.round(s.prom/maxProm*100)}%"></div>
      </div>
      <div class="asist-tipo-max">Máxima: <strong>${s.max||'—'}</strong></div>
    </div>`).join('')}
  </div>`;
}

function renderAsistenciaChart() {
  const el = document.getElementById('asistChartWrap'); if(!el) return;
  let lista = (state.asistencia||[]).slice().reverse(); // cronológico
  if(asistChartFilter !== 'todos') lista = lista.filter(r => r.tipo === asistChartFilter);

  // Últimas 20 reuniones
  lista = lista.slice(-20);

  if(!lista.length) {
    el.innerHTML = '<div style="text-align:center;padding:32px;color:var(--ink-3);font-size:13px">Sin datos suficientes para graficar</div>';
    return;
  }

  const maxVal = Math.max(...lista.map(r=>r.total), 1);
  const W = 700, H = 160, padL = 32, padB = 40, padT = 10, padR = 10;
  const barW = Math.min(28, Math.floor((W-padL-padR) / lista.length) - 4);
  const gap  = (W - padL - padR - barW * lista.length) / (lista.length + 1);
  const colores = { 'Entre semana':'#1d4ed8', 'Fin de semana':'#15803d' };

  // Líneas guía
  const guias = [0, 0.25, 0.5, 0.75, 1].map(f => {
    const v = Math.round(maxVal * f);
    const y = padT + (H - padT - padB) * (1 - f);
    return `<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="#e5e0d8" stroke-width="1"/>
            <text x="${padL-4}" y="${y+4}" font-size="9" fill="#a09a93" text-anchor="end">${v}</text>`;
  }).join('');

  const bars = lista.map((r, i) => {
    const x = padL + gap + i * (barW + gap);
    const barH = ((H - padT - padB) * r.total / maxVal);
    const y = padT + (H - padT - padB) - barH;
    const col = colores[r.tipo] || '#64748b';
    const [yr, mo, dy] = r.fecha.split('-');
    const label = `${dy}/${mo}`;
    const presH = ((H - padT - padB) * r.presencial / maxVal);
    const zoomH = barH - presH;
    return `
      <title>${r.fecha} · ${r.tipo}\nTotal: ${r.total} (${r.presencial} presencial + ${r.zoom} zoom)</title>
      <rect x="${x}" y="${y+zoomH}" width="${barW}" height="${presH}" fill="${col}" rx="2" opacity=".9"/>
      <rect x="${x}" y="${y}" width="${barW}" height="${zoomH}" fill="${col}" rx="2" opacity=".45"/>
      <text x="${x+barW/2}" y="${H-padB+14}" font-size="9" fill="#a09a93" text-anchor="middle">${label}</text>
      <text x="${x+barW/2}" y="${y-4}" font-size="9" fill="${col}" text-anchor="middle" font-weight="600">${r.total}</text>`;
  }).join('');

  // Línea de promedio
  const prom = Math.round(lista.reduce((s,r)=>s+r.total,0)/lista.length);
  const yProm = padT + (H - padT - padB) * (1 - prom / maxVal);
  const promLine = `<line x1="${padL}" y1="${yProm}" x2="${W-padR}" y2="${yProm}" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4,3"/>
    <text x="${W-padR+2}" y="${yProm+4}" font-size="9" fill="#f59e0b" font-weight="600">Ø${prom}</text>`;

  el.innerHTML = `<div style="overflow-x:auto">
    <svg viewBox="0 0 ${W} ${H}" class="asist-chart-svg" style="min-width:${Math.max(W, lista.length*40)}px;height:${H}px">
      ${guias}${bars}${promLine}
    </svg>
    <div style="display:flex;gap:16px;margin-top:8px;font-size:11px;color:var(--ink-3)">
      <span><span style="display:inline-block;width:10px;height:10px;background:#1d4ed8;border-radius:2px;margin-right:4px"></span>Entre semana</span>
      <span><span style="display:inline-block;width:10px;height:10px;background:#15803d;border-radius:2px;margin-right:4px"></span>Fin de semana</span>
      <span><span style="display:inline-block;width:22px;height:2px;background:#f59e0b;border-radius:1px;margin-right:4px;vertical-align:middle"></span>Promedio</span>
      <span style="color:var(--ink-3)">· Barra sólida = presencial · transparente = Zoom</span>
    </div>
  </div>`;
}

function renderAsistenciaTabla() {
  const el = document.getElementById('asistTabla'); if(!el) return;
  let lista = state.asistencia||[];
  if(asistRecordFilter !== 'todos') lista = lista.filter(r => r.tipo === asistRecordFilter);
  const colores = { 'Entre semana':'#1d4ed8', 'Fin de semana':'#15803d' };
  const maxTotal = lista.length ? Math.max(...lista.map(r=>r.total), 1) : 1;

  if(!lista.length) {
    el.innerHTML = `<div class="asist-empty-state">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <div style="font-size:14px;font-weight:600;margin-top:8px">Sin reuniones registradas</div>
      <div style="font-size:12px;margin-top:4px">Usa el formulario de arriba para agregar</div>
    </div>`;
    return;
  }

  el.innerHTML = `<table class="asist-tbl">
    <thead><tr>
      <th>Fecha</th><th>Tipo</th><th>Tema</th>
      <th style="text-align:center">Presencial</th>
      <th style="text-align:center">Zoom</th>
      <th style="text-align:center">Total</th>
      <th>Notas</th><th></th>
    </tr></thead>
    <tbody>
    ${lista.map(r => {
      const col = colores[r.tipo]||'#64748b';
      const [y,m,d] = r.fecha.split('-');
      const pct = Math.round(r.total/maxTotal*80);
      return `<tr>
        <td style="font-weight:600;white-space:nowrap">${d}/${m}/${y}</td>
        <td><span class="asist-tipo-pill" style="background:${col}18;color:${col}">${r.tipo}</span></td>
        <td style="font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(r.tema||'—')}</td>
        <td style="text-align:center;font-weight:700;color:#1d4ed8">${r.presencial}</td>
        <td style="text-align:center;font-weight:700;color:#6d28d9">${r.zoom}</td>
        <td style="text-align:center">
          <span style="font-weight:800;font-size:15px">${r.total}</span>
          <span class="asist-bar" style="width:${pct}px;background:${col}40"></span>
        </td>
        <td style="font-size:11px;color:var(--ink-3);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(r.notas||'')}</td>
        <td><button class="asist-del" onclick="eliminarReunion('${r.id}')" title="Eliminar" style="${can('asistencia')?'':'display:none'}">✕</button></td>
      </tr>`;
    }).join('')}
    </tbody>
  </table>`;
}

function exportarAsistenciaExcel() {
  const lista = state.asistencia||[];
  if(!lista.length){ toast('No hay datos de asistencia'); return; }
  const headers = ['Fecha','Tipo de reunión','Tema','Presencial','Zoom','Total','Notas'];
  const filas = lista.map(r => {
    const [y,m,d] = r.fecha.split('-');
    return [`${d}/${m}/${y}`, r.tipo, r.tema||'', r.presencial, r.zoom, r.total, r.notas||''];
  });
  const wsData = [headers, ...filas];
  const ws = XLSX.utils.aoa_to_sheet(wsData);
  ws['!cols'] = [{wch:12},{wch:16},{wch:34},{wch:12},{wch:10},{wch:8},{wch:30}];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Asistencia');
  XLSX.writeFile(wb, `Asistencia_${new Date().toISOString().slice(0,10)}.xlsx`);
  toast('Excel exportado ✓');
}


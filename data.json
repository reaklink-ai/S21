function exportarHistoricoExcel() {
  const MESES_C = ['Sep','Oct','Nov','Dic','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago'];

  // Recolectar años disponibles
  const aniosSet = new Set();
  state.publicadores.forEach(p => Object.keys(p.registros||{}).forEach(a => aniosSet.add(Number(a))));
  const anios = [...aniosSet].sort();
  if(!anios.length){ toast('No hay registros de informes'); return; }

  // Construir CSV con columnas: Grupo | Apellido | Nombre | Privilegio | [anio/mes...]
  const cols = ['Grupo','Apellido','Nombre','Privilegio'];
  anios.forEach(a => MESES_C.forEach(m => cols.push(`${m} ${a}-${a+1}`)));

  const rows = [cols];

  // Ordenar por grupo luego apellido
  const pubs = [...state.publicadores].sort((a,b)=>(a.grupo||'').localeCompare(b.grupo||'','es')||(a.apellido||'').localeCompare(b.apellido||'','es'));

  function priv(p) {
    if(p.misionero) return 'Misionero';
    if(p.precursorEsp) return 'Prec. Esp.';
    if(p.precursorReg) return 'Prec. Reg.';
    if(p.anciano) return 'Anciano';
    if(p.siervo) return 'Siervo';
    return 'Publicador';
  }

  pubs.forEach(pub => {
    const row = [pub.grupo||'', pub.apellido||'', pub.nombre||'', priv(pub)];
    anios.forEach(a => {
      MESES_C.forEach(m => {
        const v = (pub.registros||{})[a]?.[m] || (pub.registros||{})[String(a)]?.[m];
        if(!v) { row.push(''); return; }
        if(v.particip) {
          const partes = [];
          if(v.paux) partes.push('PA');
          if(v.horas) partes.push(v.horas+'h');
          if(v.cursos) partes.push(v.cursos+'c');
          row.push(partes.length ? partes.join(' ') : 'SI');
        } else {
          row.push('NO');
        }
      });
    });
    rows.push(row);
  });

  // Hoja 2: resumen por mes
  const rows2 = [['Mes','Total','Participaron','No Predicaron','% Participación','Prec. Auxiliares','Total Horas','Total Cursos']];
  anios.forEach(a => {
    MESES_C.forEach(m => {
      let part=0, noPred=0, paux=0, horas=0, cursos=0;
      state.publicadores.forEach(p => {
        const v = (p.registros||{})[a]?.[m] || (p.registros||{})[String(a)]?.[m];
        if(v && v.particip){ part++; if(v.paux) paux++; horas+=parseFloat(v.horas)||0; cursos+=parseInt(v.cursos)||0; }
        else noPred++;
      });
      const total = state.publicadores.length;
      const pct = total ? Math.round(part/total*100)+'%' : '0%';
      rows2.push([`${m} ${a}-${a+1}`, total, part, noPred, pct, paux, horas||'', cursos||'']);
    });
  });

  // Generar como ZIP con 2 CSV (simulado como TSV en un solo CSV con separador de sección)
  // Usar formato CSV descargable
  function toCSV(data) {
    return data.map(r => r.map(v => {
      const s = String(v==null?'':v);
      return s.includes(',') || s.includes('"') || s.includes('\n') ? `"${s.replace(/"/g,'""')}"` : s;
    }).join(',')).join('\n');
  }

  const combined = '=== HISTÓRICO INFORMES ===\n' + toCSV(rows) + '\n\n=== RESUMEN POR MES ===\n' + toCSV(rows2);
  const bom = '\uFEFF';
  const blob = new Blob([bom + combined], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `S21_Historico_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  toast('✓ Histórico exportado');
}


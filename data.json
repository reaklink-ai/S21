      <button class="btn-cancel" onclick="cerrarGestionUsuarios()">Cerrar</button>
    </div>
  </div>
</div>

</div><!-- /appWrap -->

</body>
</html>`;

  const blob = new Blob([html], {type:'text/html;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const w = window.open(url, '_blank');
  if(!w) {
    const a = document.createElement('a');
    a.href = url;
    a.download = `Emergencias_Congregacion_${new Date().toISOString().slice(0,10)}.html`;
    a.click();
  }
  toast('Directorio generado ✓');
}

// ══════════════════════════════════════════
//  INFORMES POR GRUPO — PLANTILLA E IMPORTACIÓN
// ══════════════════════════════════════════

function mesActual() {
  // REGLA: Los informes se envían a la sucursal el día 20 de cada mes.
  // - Antes del día 20: el mes a reportar es el MES ANTERIOR (aún no se envió)
  // - Día 20 en adelante: el mes a reportar es el MES ACTUAL (ya se cerró y se envía)
  // Ejemplo: 15 marzo → reportar febrero | 20 marzo → reportar marzo
  const ahora = new Date();
  let m = ahora.getMonth();    // 0=ene..11=dic
  let a = ahora.getFullYear();
  const dia = ahora.getDate();

  if(dia < 20) {
    // Antes del 20: retroceder un mes
    if(m === 0) { m = 11; a--; } else { m--; }
  }
  // Día 20+: usar el mes calendario actual tal cual

  // Mapeo de mes calendario a índice en MESES_C (Sep=0 ... Ago=11)
  const mapMes = {8:0,9:1,10:2,11:3,0:4,1:5,2:6,3:7,4:8,5:9,6:10,7:11};
  const idx = mapMes[m];
  // Año de inicio del año de servicio
  const anio = (m >= 8) ? a : a - 1;
  return { idx, mesC: MESES_C[idx], mesNombre: MESES[idx], anio };
}

function mesVencidoLabel() {
  const { mesNombre, anio } = mesActual();
  const ahora = new Date();
  const sufijo = ahora.getDate() >= 20 ? ' (en curso)' : ' (vencido)';
  return `${mesNombre} ${anio}\u2013${anio+1}${sufijo}`;
}

function mesVencidoInfo() {
  const ahora = new Date();
  const dia = ahora.getDate();
  const { mesNombre } = mesActual();
  if(dia < 20) {
    return 'Mes a reportar: <b>' + mesNombre + '</b> \xb7 Faltan <b>' + (20-dia) + ' d\xedas</b> para el env\xedo (d\xeda 20)';
  } else {
    return 'Mes a reportar: <b>' + mesNombre + '</b> \xb7 <b>Per\xedodo de env\xedo activo</b> (d\xeda 20 al 31)';
  }
}

function exportarPlantillaInformes(grupo) {
  // Si no se pasa grupo, pide selección
  if(!grupo) {
    const grupos = GRUPOS_LISTA.filter(g =>
      state.publicadores.some(p => p.grupo === g)
    );
    if(grupos.length === 0) { toast('No hay grupos con miembros asignados'); return; }
    abrirModalPlantillaInformes();
    return;
  }
  _descargarPlantillaGrupo(grupo);
}

function _descargarPlantillaGrupo(grupo) {
  const { mesC, mesNombre, anio } = mesActual();
  const anioLabel = `${anio}-${anio+1}`;
  const miembros = state.publicadores
    .filter(p => p.grupo === grupo)
    .sort((a,b) => a.apellido.localeCompare(b.apellido));

  if(miembros.length === 0) { toast('No hay publicadores en este grupo'); return; }

  // ── Columnas visibles (las internas apellido/nombre/id/mes van ocultas al final) ──
  // Orden visual: GRUPO | PUBLICADOR | PARTICIPO | HORAS | CURSOS | PREC. AUX | COMENTARIOS
  // Columnas ocultas al final: apellido, nombre, id, mes (para importación)

  const HEADER_ROW = 2; // fila 1 = título, fila 2 = encabezados (0-indexed)

  // Fila 0: título
  const titulo = [`INFORME DE PREDICACIÓN — ${grupo.toUpperCase()} — ${mesNombre.toUpperCase()} ${anio}`];

  // Fila 1: encabezados visibles + ocultos
  const headers = [
    'GRUPO',
    'PUBLICADOR',
    'PARTICIPÓ EN EL MINISTERIO (SI/NO)',
    'HORAS',
    'CURSOS BÍBLICOS',
    'PRECURSOR AUXILIAR (SI/NO)',
    'COMENTARIOS',
    // columnas ocultas para importación:
    'apellido', 'nombre', 'id', 'mes'
  ];

  // Filas de datos
  const filas = miembros.map(p => {
    const r = getReg(p, anio, mesC);
    return [
      grupo,
      `${p.apellido} ${p.nombre}`,
      r.particip ? 'SI' : '',
      r.horas !== undefined && r.horas !== '' ? r.horas : '',
      r.cursos !== undefined && r.cursos !== '' ? r.cursos : '',
      r.paux ? 'SI' : '',
      r.notas || '',
      // ocultas:
      p.apellido, p.nombre, p.id, mesC
    ];
  });

  const wsData = [titulo, headers, ...filas];
  const ws = XLSX.utils.aoa_to_sheet(wsData);

  const totalRows = wsData.length;
  const dataStart = 2; // índice de la primera fila de datos (0-based)

  // ── Anchos de columna ──
  ws['!cols'] = [
    { wch: 10 },  // A GRUPO
    { wch: 28 },  // B PUBLICADOR
    { wch: 32 },  // C PARTICIPÓ
    { wch: 9  },  // D HORAS
    { wch: 14 },  // E CURSOS
    { wch: 22 },  // F PREC. AUX
    { wch: 35 },  // G COMENTARIOS
    { wch: 0  },  // H apellido (oculta)
    { wch: 0  },  // I nombre   (oculta)
    { wch: 0  },  // J id       (oculta)
    { wch: 0  },  // K mes      (oculta)
  ];

  // ── Altura de filas ──
  ws['!rows'] = [{ hpt: 22 }, { hpt: 30 }]; // título y encabezado más altos

  // ── Merge del título (A1:G1) ──
  ws['!merges'] = [{ s: { r: 0, c: 0 }, e: { r: 0, c: 6 } }];

  // Helper para referencia de celda
  const ref = (r, c) => XLSX.utils.encode_cell({ r, c });

  // ── Estilo del título (fila 0) ──
  const tituloCell = ws[ref(0, 0)];
  if(tituloCell) {
    tituloCell.s = {
      font:      { bold: true, sz: 13, color: { rgb: 'FFFFFF' } },
      fill:      { fgColor: { rgb: '1F3864' } },
      alignment: { horizontal: 'center', vertical: 'center' },
      border: {
        bottom: { style: 'medium', color: { rgb: 'FFFFFF' } }
      }
    };
  }

  // ── Estilo de encabezados (fila 1, columnas A–G) ──
  for(let c = 0; c < 7; c++) {
    const cell = ws[ref(1, c)];
    if(!cell) continue;
    cell.s = {
      font:      { bold: true, sz: 10, color: { rgb: 'FFFFFF' } },
      fill:      { fgColor: { rgb: '2F5496' } },
      alignment: { horizontal: 'center', vertical: 'center', wrapText: true },
      border: {
        top:    { style: 'thin', color: { rgb: 'FFFFFF' } },
        bottom: { style: 'thin', color: { rgb: 'FFFFFF' } },
        left:   { style: 'thin', color: { rgb: 'FFFFFF' } },
        right:  { style: 'thin', color: { rgb: 'FFFFFF' } },
      }
    };
  }

  // ── Estilos de filas de datos ──
  for(let r = dataStart; r < totalRows; r++) {
    const esAlterna = (r - dataStart) % 2 === 1;
    const bgColor   = esAlterna ? 'D9E1F2' : 'FFFFFF';

    for(let c = 0; c < 7; c++) {
      const cellRef = ref(r, c);
      if(!ws[cellRef]) ws[cellRef] = { t: 's', v: '' };
      const cell = ws[cellRef];

      const isCenter = c !== 1 && c !== 6; // PUBLICADOR y COMENTARIOS alineados a la izquierda
      cell.s = {
        font:      { sz: 10, color: { rgb: '1A1A1A' } },
        fill:      { fgColor: { rgb: bgColor } },
        alignment: { horizontal: isCenter ? 'center' : 'left', vertical: 'center' },
        border: {
          top:    { style: 'thin', color: { rgb: 'BFC9D9' } },
          bottom: { style: 'thin', color: { rgb: 'BFC9D9' } },
          left:   { style: 'thin', color: { rgb: 'BFC9D9' } },
          right:  { style: 'thin', color: { rgb: 'BFC9D9' } },
        }
      };
    }
  }

  // ── Ocultar columnas de importación (H–K) ──
  for(let c = 7; c <= 10; c++) {
    for(let r = 1; r < totalRows; r++) {
      const cellRef = ref(r, c);
      if(ws[cellRef]) ws[cellRef].s = { font: { color: { rgb: 'FFFFFF' }, sz: 1 } };
    }
  }

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Informes');

  XLSX.writeFile(wb, `Informe_${grupo.replace(/\s+/g,'_')}_${mesNombre}_${anioLabel}.xlsx`);
  toast(`Plantilla Excel descargada: ${grupo} · ${mesNombre}`);
}

function importarInformes() {
  document.getElementById('fileInputInformes').click();
}

function cargarInformes(e) {
  const f = e.target.files[0]; if(!f) return;
  e.target.value = '';
  const r = new FileReader();
  r.onload = ev => {
    try {
      const data = new Uint8Array(ev.target.result);
      const wb = XLSX.read(data, { type: 'array' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      const sheetName = wb.SheetNames[0];
      const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });

      // ── Detectar mes/año del nombre de la hoja (ej: "FEBRERO 2026") ──
      const MESES_ES = {
        'enero':0,'febrero':1,'marzo':2,'abril':3,'mayo':4,'junio':5,
        'julio':6,'agosto':7,'septiembre':8,'octubre':9,'noviembre':10,'diciembre':11
      };
      const MES_A_IDX = {8:0,9:1,10:2,11:3,0:4,1:5,2:6,3:7,4:8,5:9,6:10,7:11};

      let mesCal=-1, anioExcel=-1;
      sheetName.toLowerCase().split(/[\s_\-]+/).forEach(p => {
        if(MESES_ES[p]!==undefined) mesCal=MESES_ES[p];
        if(/^\d{4}$/.test(p)) anioExcel=parseInt(p);
      });

      // ── Detectar columnas ──
      let headerRowIdx=0;
      for(let i=0;i<Math.min(rows.length,5);i++){
        const r0=rows[i].map(c=>String(c).toUpperCase().trim());
        if(r0.some(h=>h.includes('PUBLICADOR')||h.includes('APELLIDO'))){headerRowIdx=i;break;}
      }
      const headers=rows[headerRowIdx].map(h=>String(h).toUpperCase().trim());
      const col=key=>headers.findIndex(h=>h.includes(key));
      const esFormatoCong = col('PUBLICADOR')>=0 && col('PARTICIPO')>=0 && col('ACTIVIDAD')>=0;

      if(!esFormatoCong || mesCal<0 || anioExcel<0) {
        // Formato viejo de la app
        _importarFormatoViejo(rows); return;
      }

      const mesIdx   = MES_A_IDX[mesCal];
      const mesC     = MESES_C[mesIdx];
      const anioEsc  = mesCal>=8 ? anioExcel : anioExcel-1;

      // ── Búsqueda normalizada ──
      function normN(s){ return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9\s]/g,'').trim().replace(/\s+/g,' '); }
      const idx=state.publicadores.map(p=>({pub:p,k1:normN(`${p.apellido} ${p.nombre}`),k2:normN(`${p.nombre} ${p.apellido}`)}));
      function buscarPub(nombre){
        const q=normN(nombre); if(!q) return null;
        let f=idx.find(x=>x.k1===q||x.k2===q); if(f) return f.pub;
        f=idx.find(x=>q.includes(normN(x.pub.apellido))&&q.includes(normN(x.pub.nombre))); if(f) return f.pub;
        f=idx.find(x=>x.k1.includes(q)||q.includes(x.k1)); return f?f.pub:null;
      }

      const iAct=col('ACTIVIDAD'), iPub=col('PUBLICADOR'), iPart=col('PARTICIPO');
      const iHoras=col('HORAS'), iCursos=col('CURSOS'), iComent=col('COMENTARIOS');

      let ok=0, skip=0, noEnc=[];
      for(let i=headerRowIdx+1;i<rows.length;i++){
        const row=rows[i];
        if(row.every(c=>String(c).trim()==='')) continue;
        const nombre=String(row[iPub]||'').trim(); if(!nombre) continue;
        const pub=buscarPub(nombre);
        if(!pub){skip++;noEnc.push(nombre);continue;}
        const act=String(row[iAct]||'').toUpperCase();
        const particip=String(row[iPart]||'').toUpperCase()==='SI';
        const paux=act.includes('AUXILIAR');
        const noInf=act.includes('NO INFORM');
        const horas=row[iHoras]?String(row[iHoras]).trim():'';
        const cursos=row[iCursos]?String(parseInt(row[iCursos])):'';
        const notas=iComent>=0&&row[iComent]?String(row[iComent]).trim():'';
        if(!pub.registros)pub.registros={};
        if(!pub.registros[anioEsc])pub.registros[anioEsc]={};
        if(!pub.registros[anioEsc][mesC])pub.registros[anioEsc][mesC]={};
        const reg=pub.registros[anioEsc][mesC];
        reg.particip=noInf?false:particip;
        if(paux)reg.paux=true;
        if(horas)reg.horas=horas;
        if(cursos)reg.cursos=cursos;
        if(notas)reg.notas=notas;
        actualizarTotales(pub,anioEsc);
        ok++;
      }

      saveStateAndSync();
      if(selId)renderS21();
      renderDashboard(); renderLista();
      toast(`✓ ${ok} informes de ${mesC} ${anioEsc}-${anioEsc+1} importados${skip>0?` · ${skip} no encontrados`:''}`, skip>0?4000:2500);
      if(noEnc.length>0) console.warn('No encontrados:', noEnc);

    } catch(err) {
      alert('Error al leer el archivo Excel: ' + err.message);
    }
  };
  r.readAsArrayBuffer(f);
}

function _importarFormatoViejo(rows) {
  let headerRowIdx=-1;
  for(let i=0;i<rows.length;i++){
    const row=rows[i].map(c=>String(c).toLowerCase().trim());
    if((row.some(h=>h.includes('publicador'))||row.includes('apellido'))&&row.includes('id')){headerRowIdx=i;break;}
  }
  if(headerRowIdx<0){alert('No se encontró la fila de encabezados');return;}
  const headers=rows[headerRowIdx].map(h=>String(h).toLowerCase().replace(/\s*\(.*\)/,'').trim());
  const getCol=(row,...keys)=>{const i=headers.findIndex(h=>keys.some(k=>h.includes(k)));return i>=0?String(row[i]||'').trim():'';};
  let ok=0,skip=0;
  for(let i=headerRowIdx+1;i<rows.length;i++){
    const row=rows[i];
    if(row.every(c=>String(c).trim()===''))continue;
    const id=getCol(row,'id');
    const mesC=getCol(row,'mes');
    const particip=getCol(row,'participó','particip').toUpperCase()==='SI';
    const cursos=getCol(row,'cursos');
    const paux=getCol(row,'precursor','paux').toUpperCase()==='SI';
    const horas=getCol(row,'horas');
    const notas=getCol(row,'comentarios','notas');
    let pub=id?state.publicadores.find(p=>p.id===id):null;
    if(!pub){const pc=getCol(row,'publicador').toLowerCase();if(pc)pub=state.publicadores.find(p=>`${p.apellido} ${p.nombre}`.toLowerCase()===pc||`${p.nombre} ${p.apellido}`.toLowerCase()===pc);}
    if(!pub){skip++;continue;}
    let mesIdx=MESES_C.findIndex(m=>m.toLowerCase()===mesC.toLowerCase());
    if(mesIdx<0){const{mesC:m}=mesActual();mesIdx=MESES_C.findIndex(x=>x===m);}
    if(mesIdx<0){skip++;continue;}
    const anio=anioHoy();
    const reg=getReg(pub,anio,MESES_C[mesIdx]);
    if(particip||paux){reg.particip=particip;reg.paux=paux;}
    if(cursos!=='')reg.cursos=cursos;
    if(horas!=='')reg.horas=horas;
    if(notas!=='')reg.notas=notas;
    actualizarTotales(pub,anio);
    ok++;
  }
  saveStateAndSync();
  if(selId)renderS21();
  renderDashboard();
  toast(`✓ ${ok} informes importados${skip>0?` · ${skip} omitidos`:''}`);
}



// Modal selector de grupo para plantilla

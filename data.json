// Toggle secciones colapsables del panel
// ──────────────────────────────────────────
function toggleSection(key) {
  const fs = document.getElementById('fs' + key);
  if(!fs) return;
  fs.classList.toggle('open');
}

function limpiarFiltros() {
  filtroTipo = null;
  filtroGrupo = null;
  renderLista();
}

function getNombreCorto(id) {
  const p = getPub(id);
  if(!p) return '';
  return `${p.apellido.split(' ')[0]}, ${p.nombre.split(' ')[0]}`;
}

function abrirModalGrupos() {
  initGrupos();
  switchGTab('estructura');
  document.getElementById('modalGrupos').style.display = 'flex';
}

function cerrarModalGrupos() {
  document.getElementById('modalGrupos').style.display = 'none';
  renderGruposPanel();
  saveStateAndSync();
}

function switchGTab(tab) {
  ['estructura','miembros'].forEach(t => {
    document.getElementById('gtab-body-'+t).style.display = t===tab ? 'block' : 'none';
    document.getElementById('gtab-'+t).classList.toggle('active', t===tab);
  });
  if(tab==='estructura') renderGruposEditor();
  if(tab==='miembros')   renderGruposMiembros();
}

function renderGruposEditor() {
  initGrupos();
  const pubs = [...state.publicadores].sort((a,b)=>a.apellido.localeCompare(b.apellido));
  const optPubs = `<option value="">— Sin asignar —</option>` +
    pubs.map(p=>`<option value="${p.id}">${p.apellido}, ${p.nombre}</option>`).join('');

  const filas = GRUPOS_LISTA.map(g => {
    const cfg = state.grupos[g] || {};
    const n = state.publicadores.filter(p=>p.grupo===g).length;
    const selSuper = optPubs.replace(`value="${cfg.super||''}"`, `value="${cfg.super||''}" selected`);
    const selAux   = optPubs.replace(`value="${cfg.aux||''}"`,   `value="${cfg.aux||''}" selected`);
    return `<div class="grupo-editor-row">
      <div class="ge-nombre">${g}<span class="ge-count">${n} miembro${n!==1?'s':''}</span></div>
      <div class="ge-field">
        <label class="ge-label">Superintendente</label>
        <select class="grupo-sel" onchange="guardarGrupo('${g}','super',this.value)">${selSuper}</select>
      </div>
      <div class="ge-field">
        <label class="ge-label">Auxiliar</label>
        <select class="grupo-sel" onchange="guardarGrupo('${g}','aux',this.value)">${selAux}</select>
      </div>
      <span class="ge-saved" id="gSaved-${g.replace(' ','_')}">Guardado</span>
    </div>`;
  }).join('');

  document.getElementById('gruposEditorLista').innerHTML = filas;
}

function renderGruposMiembros() {
  initGrupos();
  const pubs = [...state.publicadores].sort((a,b)=>a.apellido.localeCompare(b.apellido));

  const bloques = GRUPOS_LISTA.map(g => {
    const cfg = state.grupos[g] || {};
    const miembros = state.publicadores.filter(p=>p.grupo===g);
    const sinGrupo = g === GRUPOS_LISTA[0]; // special: show ungrouped separately

    // Build checkboxes for all publishers
    const items = pubs.map(p => {
      const checked = p.grupo === g;
      const tipo = tipoPrincipal(p);
      const col = TIPO_COLOR[tipo]||'#64748b';
      return `<label class="gm-item${checked?' gm-checked':''}">
        <input type="checkbox" ${checked?'checked':''} onchange="toggleMiembro('${g}','${p.id}',this.checked)" style="display:none">
        <span class="gm-check">${checked?'✓':''}</span>
        <span class="gm-name">${p.apellido}, ${p.nombre}</span>
        <span class="gm-badge" style="background:${col}18;color:${col}">${tipo}</span>
      </label>`;
    }).join('');

    const supNombre = cfg.super ? (()=>{const p=getPub(cfg.super); return p?`${p.apellido}, ${p.nombre}`:''})() : '';
    const auxNombre = cfg.aux   ? (()=>{const p=getPub(cfg.aux);   return p?`${p.apellido}, ${p.nombre}`:''})() : '';

    return `<div class="gm-bloque">
      <div class="gm-bloque-hd">
        <div>
          <span class="gm-titulo">${g}</span>
          <span class="gm-n">${miembros.length} miembro${miembros.length!==1?'s':''}</span>
        </div>
        <div class="gm-liderazgo">
          ${supNombre?`<span class="gm-rol">Super: <b>${supNombre}</b></span>`:''}
          ${auxNombre?`<span class="gm-rol">Aux: <b>${auxNombre}</b></span>`:''}
        </div>
      </div>
      <div class="gm-grid">${items}</div>
    </div>`;
  }).join('');

  // Sin grupo
  const sinAsignar = pubs.filter(p=>!p.grupo||p.grupo==='');
  const sinItems = sinAsignar.map(p=>`
    <div class="gm-singrupo-item">
      <span>${p.apellido}, ${p.nombre}</span>
      <span style="font-size:10px;color:#aaa">${tipoPrincipal(p)}</span>
    </div>`).join('');

  document.getElementById('gruposMiembrosLista').innerHTML = bloques +
    (sinAsignar.length ? `<div class="gm-bloque" style="border-color:#fca5a5">
      <div class="gm-bloque-hd"><span class="gm-titulo" style="color:#ef4444">Sin grupo asignado</span><span class="gm-n">${sinAsignar.length}</span></div>
      <div style="padding:8px 4px">${sinItems}</div>
    </div>` : '');
}

function toggleMiembro(grupo, pubId, checked) {
  const pub = getPub(pubId);
  if(!pub) return;
  if(checked) {
    pub.grupo = grupo;
  } else {
    if(pub.grupo === grupo) pub.grupo = '';
  }
  saveStateAndSync();
  renderGruposPanel();
  renderGruposMiembros(); // re-render to update all checkboxes
  toast(`${pub.apellido} asignado a ${checked?grupo:'sin grupo'}`);
}

function guardarGrupo(grupo, campo, valor) {
  initGrupos();
  if(!state.grupos[grupo]) state.grupos[grupo] = {};
  state.grupos[grupo][campo] = valor;
  saveStateAndSync();
  // Feedback visual
  const key = grupo.replace(' ','_');
  const el = document.getElementById('gSaved-'+key);
  if(el){ el.style.display='inline'; setTimeout(()=>el.style.display='none', 1500); }
  renderGruposPanel();
}



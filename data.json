function filtrarTipo(tipo) {
  filtroTipo = (filtroTipo===tipo) ? null : tipo;
  filtroGrupo = null; // limpiar filtro por grupo
  renderLista();
  document.getElementById('pubList').scrollTop=0;
}

function renderStats() {
  const p = state.publicadores;
  const ancianos    = p.filter(x=>x.anciano).length;
  const siervos     = p.filter(x=>x.siervo && !x.anciano).length;
  const precReg     = p.filter(x=>x.precursorReg).length;
  const precEsp     = p.filter(x=>x.precursorEsp).length;
  const misioneros  = p.filter(x=>x.misionero).length;
  const publicadores= p.filter(x=>!x.anciano&&!x.siervo&&!x.precursorReg&&!x.precursorEsp&&!x.misionero).length;

  document.getElementById('stAncianos').textContent    = ancianos;
  document.getElementById('stSiervos').textContent     = siervos;
  document.getElementById('stPrecReg').textContent     = precReg;
  document.getElementById('stPrecEsp').textContent     = precEsp;
  document.getElementById('stMisioneros').textContent  = misioneros;
  document.getElementById('stPublicadores').textContent= publicadores;
  document.getElementById('stTotal').textContent       = p.length;
}


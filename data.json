let pantallaActual = 'inicio';

function volverLista() {
  const panel = document.getElementById('panelLista');
  if(panel) panel.classList.remove('panel-hidden');
  selId = null;
}

function irA(pantalla) {
  pantallaActual = pantalla;
  document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
  const el = document.getElementById('screen-'+pantalla);
  if(el) el.style.display = 'block';
  // Sidebar nav
  document.querySelectorAll('.sb-nav-item').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById('sbnav-'+pantalla);
  if(btn) btn.classList.add('active');
  // Mobile nav
  document.querySelectorAll('.mob-nav-item').forEach(b => b.classList.remove('active'));
  const mbtn = document.getElementById('mobnav-'+pantalla);
  if(mbtn) mbtn.classList.add('active');
  // En móvil al ir a publicadores, mostrar lista
  if(pantalla === 'publicadores') {
    const panel = document.getElementById('panelLista');
    if(panel) panel.classList.remove('panel-hidden');
  }
  if(pantalla === 'inicio')       renderDashboard();
  if(pantalla === 'publicadores') renderLista();
  if(pantalla === 'grupos')       renderGruposScreen();
  if(pantalla === 'inactivos')    renderInactivos();
  if(pantalla === 'asistencia')   renderAsistenciaScreen();
  if(pantalla === 'vym')          renderVyM();
  if(pantalla === 'precursores')  renderPrecursores();
  applyRoleUI();
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('collapsed');
}


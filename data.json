function renderInactivos() {
  const wrap = document.getElementById('inactivosWrap');
  if(!wrap) return;
  const inact = (state.inactivos || []).sort((a,b) => a.apellido.localeCompare(b.apellido));

  const items = inact.length === 0
    ? `<div style="text-align:center;padding:60px 20px;color:var(--ink-3)">
        <div style="font-size:40px;margin-bottom:12px;opacity:.3">○</div>
        <div style="font-size:15px;font-weight:600">Sin publicadores inactivos</div>
        <div style="font-size:13px;margin-top:6px">Mueve publicadores aquí desde la lista principal</div>
       </div>`
    : inact.map(p => {
        const tipo = tipoPrincipal(p);
        const color = TIPO_COLOR[tipo] || '#64748b';
        const ini = (p.apellido[0]||'')+(p.nombre[0]||'');
        const fechaInact = p.fechaInactivo ? `<span style="font-size:11px;color:var(--ink-3);margin-left:8px">Desde ${p.fechaInactivo}</span>` : '';
        const motivo = p.motivoInactivo ? `<div style="font-size:11px;color:var(--ink-3);margin-top:2px">${escHtml(p.motivoInactivo)}</div>` : '';
        return `<div class="inact-item">
          <div class="pub-av" style="background:${color}18;color:${color};flex-shrink:0">${ini}</div>
          <div style="flex:1;min-width:0">
            <div style="font-size:14px;font-weight:600;color:var(--ink)">${escHtml(p.apellido)}, ${escHtml(p.nombre)}${fechaInact}</div>
            <div style="font-size:12px;color:${color};font-weight:600">${tipo} · ${p.grupo||'Sin grupo'}</div>
            ${motivo}
          </div>
          <button class="gs-btn gs-btn-prim" onclick="reactivarPub('${p.id}')" style="white-space:nowrap;flex-shrink:0">↩ Reactivar</button>
        </div>`;
      }).join('');

  wrap.innerHTML = `
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:12px;flex-wrap:wrap">
      <div>
        <div style="font-family:var(--font-serif);font-size:26px;font-weight:600;color:var(--ink);letter-spacing:-.4px">Inactivos</div>
        <div style="font-size:13px;color:var(--ink-3);margin-top:3px">${inact.length} publicador${inact.length!==1?'es':''} sacado${inact.length!==1?'s':''} de la congregación</div>
      </div>
    </div>
    <div class="inact-list">${items}</div>`;
}

function moverAInactivos(id) {
  document.getElementById('modalInactivoOverlay').style.display = 'flex';
  document.getElementById('inactivoIdTarget').value = id;
  document.getElementById('inactivoMotivo').value = '';
  const pub = getPub(id);
  document.getElementById('inactivoNombre').textContent = pub ? `${pub.apellido}, ${pub.nombre}` : '';
}

function cerrarModalInactivo() {
  document.getElementById('modalInactivoOverlay').style.display = 'none';
}

function confirmarInactivo() {
  const id     = document.getElementById('inactivoIdTarget').value;
  const motivo = document.getElementById('inactivoMotivo').value.trim();
  const pub    = getPub(id);
  if(!pub) return;

  // Remove from active list
  state.publicadores = state.publicadores.filter(p => p.id !== id);

  // Add to inactivos
  if(!state.inactivos) state.inactivos = [];
  const hoy = new Date().toISOString().slice(0,10);
  state.inactivos.push({ ...pub, fechaInactivo: hoy, motivoInactivo: motivo });

  saveStateAndSync();
  selId = null;
  cerrarModalInactivo();
  renderLista();
  renderDashboard();
  toast(`${pub.apellido}, ${pub.nombre} movido a Inactivos`);
}

function reactivarPub(id) {
  if(!state.inactivos) return;
  const idx = state.inactivos.findIndex(p => p.id === id);
  if(idx < 0) return;
  const pub = { ...state.inactivos[idx] };
  delete pub.fechaInactivo;
  delete pub.motivoInactivo;
  state.inactivos.splice(idx, 1);
  state.publicadores.push(pub);
  saveStateAndSync();
  renderInactivos();
  renderDashboard();
  toast(`${pub.apellido}, ${pub.nombre} reactivado`);
}


// ══════════════════════════════════════════
//  AUTH — LOGIN / LOGOUT / GESTIÓN USUARIOS
// ══════════════════════════════════════════
function getUsuarios() {
  if(!state.usuarios || state.usuarios.length === 0) {
    state.usuarios = [ { ...DEFAULT_ADMIN } ];
  }
  return state.usuarios;
}

function migrarUsuariosLegacy() {
  if(!state.usuarios) return;
  state.usuarios.forEach(u => {
    // Normalizar nombre: si solo tiene 'usuario', usarlo como nombre
    if(!u.nombre && u.usuario) u.nombre = u.usuario;
    // Asignar PIN si no tiene
    if(!u.pin) {
      u.pin = (u.id === 'admin') ? '4535' : '0000';
    }
    // Limpiar campos legacy
    delete u.passHash;
    delete u.usuario;
  });
}

async function sha256(str) {
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
    return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
  } catch(e) { return str; }
}

async function verificarLogin() {
  const nombreInput = (document.getElementById('loginUser')?.value || '').trim();
  const pin         = (document.getElementById('loginPass')?.value || '').trim();
  if(!nombreInput || !pin) { toast('Ingresa nombre y PIN'); return; }

  // Mostrar "Verificando..."
  const btnLogin = document.querySelector('#loginScreen button[onclick="verificarLogin()"]');
  if(btnLogin) { btnLogin.textContent = 'Verificando...'; btnLogin.disabled = true; }

  // Cargar usuarios frescos desde el Worker antes de comparar
  try {
    const res = await fetch(SYNC_URL + '?t=' + Date.now());
    if(res.ok) {
      const json   = await res.json();
      const remoto = json.data;
      if(remoto) {
        state = remoto;
        if(!state.usuarios || state.usuarios.length === 0) state.usuarios = [ { ...DEFAULT_ADMIN } ];
        migrarUsuariosLegacy();
        localStorage.setItem(KEY, JSON.stringify(state));
      }
    }
  } catch(e) { /* continuar con datos locales si el Worker no responde */ }

  if(btnLogin) { btnLogin.textContent = 'Ingresar'; btnLogin.disabled = false; }

  const users = getUsuarios();
  const user  = users.find(u => u.nombre.toLowerCase() === nombreInput.toLowerCase() && u.pin === pin);

  if(!user) {
    const err = document.getElementById('loginError');
    if(err) { err.style.display='block'; setTimeout(()=>err.style.display='none', 2500); }
    document.getElementById('loginPass').value = '';
    document.getElementById('loginPass').focus();
    return;
  }

  // Login exitoso
  currentUser = user;
  sessionStorage.setItem('s21_user', JSON.stringify(user));
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('appWrap').style.display = 'block';
  document.getElementById('appbar').style.display = 'flex';
  document.getElementById('appLayout').style.display = 'flex';
  const nav = document.getElementById('mobileNav');
  if(nav) nav.style.removeProperty('display');
  if(document.getElementById('appbar-user')) document.getElementById('appbar-user').textContent = user.nombre;
  if(document.getElementById('appbar-rol')) {
    document.getElementById('appbar-rol').textContent = getRolLabel(user.rol);
    document.getElementById('appbar-rol').style.color = getRolColor(user.rol);
  }
  applyRoleUI();
  irA('inicio');
}

function logout() {
  currentUser = null;
  sessionStorage.removeItem('s21_user');
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('appWrap').style.display = 'none';
  if(document.getElementById('loginUser')) document.getElementById('loginUser').value = '';
  if(document.getElementById('loginPass')) document.getElementById('loginPass').value = '';
  if(document.getElementById('loginError')) document.getElementById('loginError').style.display = 'none';
  setTimeout(() => document.getElementById('loginUser')?.focus(), 100);
}

function applyRoleUI() {
  if(!currentUser) return;
  const rol = currentUser.rol;
  const esAnciano = rol === 'anciano' && currentUser.grupo;

  // Elementos por permiso de clase CSS
  document.querySelectorAll('.sb-perm-edit').forEach(el => {
    el.style.display = canEdit() ? '' : 'none';
  });
  document.querySelectorAll('.sb-perm-export').forEach(el => {
    el.style.display = can('exportar') ? '' : 'none';
  });
  document.querySelectorAll('.sb-perm-admin').forEach(el => {
    el.style.display = (rol === 'admin') ? '' : 'none';
  });
  document.querySelectorAll('.filter-cfg-btn').forEach(el => {
    el.style.display = can('editarTodo') ? '' : 'none';
  });
  document.querySelectorAll('.gs-btn-prim, .btn-gestionar-grupos').forEach(el => {
    el.style.display = can('editarTodo') ? '' : 'none';
  });

  // ── Control específico para Anciano ──
  const ids = {
    metricas:    document.getElementById('sbnav-metricas'),
    emergencias: document.getElementById('sbnav-emergencias'),
    secDatos:    document.getElementById('sbSectionDatos'),
    secAnciano:  document.getElementById('sbDatosAnciano'),
    vym:         document.getElementById('sbnav-vym'),
    mobVym:      document.getElementById('mobnav-vym'),
  };

  // Control de secciones según permisos individuales o defaults de rol
  const verVym      = puedeVerSeccion('vym');
  const verMetricas = puedeVerSeccion('metricas');
  const verDatos    = puedeVerSeccion('datos');

  if(ids.vym)         ids.vym.style.display         = verVym ? '' : 'none';
  if(ids.mobVym)      ids.mobVym.style.display       = verVym ? '' : 'none';
  if(ids.metricas)    ids.metricas.style.display     = verMetricas ? '' : 'none';
  if(ids.emergencias) ids.emergencias.style.display  = (rol==='admin'||rol==='secretario') ? '' : 'none';

  // Sección de datos: anciano ve su menú reducido, resto ve el completo
  if(esAnciano) {
    if(ids.secDatos)   ids.secDatos.style.display   = verDatos ? '' : 'none';
    if(ids.secAnciano) ids.secAnciano.style.display = '';
  } else {
    if(ids.secDatos)   ids.secDatos.style.display   = (rol==='admin'||rol==='secretario') ? '' : 'none';
    if(ids.secAnciano) ids.secAnciano.style.display = 'none';
  }

  // Formulario de asistencia — solo admin/secretario
  const fc = document.getElementById('asistFormCard');
  if(fc) fc.style.display = can('asistencia') ? '' : 'none';
}


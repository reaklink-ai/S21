              ${parte.mins ? `<div class="vym-parte-mins">${parte.mins} min.</div>`:''}
            </div>
            <div class="vym-asign-wrap">
              ${conAyudante ? `
                <div class="vym-sala-bloque">
                  <div class="vym-sala-titulo">Sala Principal</div>
                  <div class="vym-sala-fila">
                    <div class="vym-asign">
                      <div class="vym-asign-label">Estudiante</div>
                      <select class="vym-select${clsAnc}" onchange="vymSetAsign('${key}','${parte.id}','prin',this.value)">${vymOpcionesSelect(rol,vPrin)}</select>
                    </div>
                    <div class="vym-asign">

function vymParsearTexto(texto, fechaKey) {
  const semana = { fechaKey, partes: [], libros: '', cargado: true };

  const lineas = texto.split('\n').map(l=>l.trim());

  // Unir línea de nombre con la siguiente si ésta empieza con (N min
  const unidas = [];
  for(let i=0; i<lineas.length; i++) {
    const l = lineas[i];
    if(!l) continue;
    const sig = (lineas[i+1]||'').trim();
    if(sig && /^\(\d+\s*min/i.test(sig)) {
      unidas.push(l + '\n' + sig);
      i++;
    } else {
      unidas.push(l);
    }
  }

  const partes = [];
  let seccion = 'tesoros';
  let orden = 0;
  partes.push({ id:'presidente', nombre:'Presidente de la reunión', mins:null, seccion:'apertura', doble:false, soloAncianos:false });

  unidas.forEach(linea => {
    const t = linea.trim();
    if(!t) return;
    if(/TESOROS DE LA BIBLIA/i.test(t))   { seccion='tesoros';  return; }
    if(/SEAMOS MEJORES MAESTROS/i.test(t)) { seccion='maestros'; return; }
    if(/NUESTRA VIDA CRISTIANA/i.test(t))  { seccion='vida';     return; }
    // Capturar Canción de apertura (primera que aparece, con "y oración")
    if(/Canción\s+\d+.*oración/i.test(t) || /^Canción\s+\d+\s*y\s*oración/i.test(t)) {
      const numMatch = t.match(/Canción\s+(\d+)/i);
      if(numMatch) {
        if(!semana.cancionApertura) semana.cancionApertura = numMatch[1];
        else semana.cancionCierre = numMatch[1];
      }
      return;
    }
    if(/^Canción\s+\d+$/i.test(t)) return; // Canción intermedia (NVC), ignorar

    // Capturar libros bíblicos (ej: ISAÍAS 45-47)
    if(/^[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑa-záéíóúñ\s]+\s+\d[\d\-,\s]*$/.test(t) && !/min/i.test(t)) {
      semana.libros = t; return;
    }

    const minsMatch = t.match(/\((\d+)\s*min/i);
    if(!minsMatch) return;

    orden++;
    const mins = parseInt(minsMatch[1]);
    // Extraer nombre: número inicial + todo antes de los paréntesis de minutos
    // Nombre: primera línea de la parte (antes del \n con los minutos)
    const primeraLinea = t.split('\n')[0];
    let nombre = primeraLinea.replace(/^\d+\.\s*/, '');
    nombre = nombre.replace(/\s*\(\d+\s*min[^)]*\).*$/i, '').trim();
    // Quitar pipe y lo que sigue solo si lo que precede es corto (canción/oración)
    if(/\|\s*(Canción|oración)/i.test(nombre)) {
      nombre = nombre.replace(/\s*\|\s*(Canción|oración).*$/i,'').trim();
    }
    if(!nombre || nombre.length < 3) return;

    const seccionFinal = /Palabras de conclusión/i.test(nombre) ? 'cierre' : seccion;
    const esEstudio = /Estudio bíblico de la congregación/i.test(nombre);

    // Extraer detalle PRIMERO: texto después de (N mins.) — puede estar en segunda línea
    let detalle = '';
    const partsUnida = t.split('\n');
    const lineaMins = partsUnida.find(l => /\(\d+\s*min/i.test(l)) || '';
    const detalleMatch = lineaMins.match(/\(\d+\s*min[^)]*\)\s*(.+)$/i);
    if(detalleMatch) {
      detalle = detalleMatch[1].trim();
      detalle = detalle.replace(/\s*\([^)]*lmd[^)]*\)\s*\.?\s*$/i, '').trim();
      detalle = detalle.replace(/\.$/, '').trim();
    }

    // Doble sala: partes de maestros EXCEPTO si el detalle dice "Discurso"
    const esDiscurso = /discurso/i.test(detalle);
    const esMaestros = /Empiece conversaciones|Haga revisitas|Haga discípulos|Explique sus|Dé discursos/i.test(nombre);
    const doble = /Lectura de la Biblia/.test(nombre) || esMaestros; // siempre doble sala
    // conAyudante: cada sala tiene estudiante + ayudante, solo cuando es maestros y no discurso
    const conAyudante = esMaestros && !esDiscurso;

    // Rol por nombre explícito
    let rol = 'todos';
    if(/Palabras de (introducción|conclusión)/i.test(nombre)) rol = 'anciano';
    else if(/Busquemos perlas/i.test(nombre)) rol = 'anciano_siervo';
    else if(esEstudio) rol = 'anciano';
    else if(doble) rol = 'todos';
    else if(seccionFinal === 'tesoros') rol = 'anciano_siervo';
    else if(seccionFinal === 'vida') rol = 'anciano_siervo';
    else if(seccionFinal === 'cierre') rol = 'anciano';

    // Limpiar nombre con año + pipe (ej: "2026 | Informe...")
    const nombreFinal = nombre.replace(/^\d{4}\s*\|\s*/, '').trim();

    partes.push({ id:`p${orden}`, nombre:nombreFinal, detalle, mins, seccion:seccionFinal, doble, conAyudante: conAyudante||false, rol });

    if(esEstudio) {
      partes.push({ id:`p${orden}l`, nombre:'Lector (estudio bíblico)', detalle:'', mins:null, seccion:seccionFinal, doble:false, rol:'anciano_siervo', esLector:true });
    }
  });

  semana.partes = partes.length > 3 ? partes : vymPartesDefecto();
  return semana;
}

function vymCargarSemana(fechaKey, fechaISO, semanaIdx) {
  const fecha = new Date(fechaISO);
  const urlId = vymUrlPorFecha(fecha);
  const jwUrl = `https://wol.jw.org/es/wol/d/r4/lp-s/${urlId}`;
  vymMostrarModalPegar(fechaKey, fechaISO, semanaIdx, jwUrl);
}

function vymMostrarModalPegar(fechaKey, fechaISO, semanaIdx, jwUrl) {
  // Restaurar botón
  const btn = document.getElementById(`vym-load-${semanaIdx}`);
  if(btn) { btn.textContent = '⬇ Cargar programa'; btn.disabled = false; }

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px';
  overlay.innerHTML = `
    <div style="background:var(--surface);border-radius:16px;max-width:580px;width:100%;max-height:92vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3)">
      <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between">
        <div>
          <div style="font-weight:700;font-size:15px">Cargar programa</div>
          <div style="font-size:11px;color:var(--ink-3);margin-top:2px">Pega el texto de jw.org para esta semana</div>
        </div>
        <button onclick="this.closest('[style*=fixed]').remove()" style="background:none;border:none;font-size:22px;cursor:pointer;color:var(--ink-3);line-height:1">×</button>
      </div>
      <div style="padding:14px 20px;background:#f0f7ff;border-bottom:1px solid #bfdbfe">
        <div style="font-size:12px;font-weight:700;color:#1e40af;margin-bottom:6px">📋 Cómo hacerlo:</div>
        <ol style="font-size:12px;color:#1e3a8a;margin:0;padding-left:18px;line-height:1.7">
          <li>Abre el programa en <a href="${jwUrl}" target="_blank" style="color:var(--accent);font-weight:700">jw.org ↗</a></li>
          <li>Selecciona todo el texto de la página (<strong>Ctrl+A</strong>)</li>
          <li>Cópialo (<strong>Ctrl+C</strong>)</li>
          <li>Pégalo aquí abajo (<strong>Ctrl+V</strong>) y presiona <strong>Procesar</strong></li>
        </ol>
      </div>
      <div style="padding:14px 20px;flex:1;overflow-y:auto">
        <textarea id="vym-paste-area" placeholder="Pega aquí el texto copiado de jw.org..."
          style="width:100%;height:220px;border:1.5px solid var(--border);border-radius:8px;padding:10px;font-size:12px;font-family:var(--font);resize:vertical;box-sizing:border-box;line-height:1.5"></textarea>
      </div>
      <div style="padding:12px 20px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end">
        <button onclick="this.closest('[style*=fixed]').remove()" style="padding:9px 18px;border-radius:8px;border:1.5px solid var(--border);background:var(--surface);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font)">Cancelar</button>
        <button onclick="vymProcesarPegado('${fechaKey}','${fechaISO}',${semanaIdx},this)"
          style="padding:9px 18px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font)">
          ✓ Procesar
        </button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

function vymProcesarPegado(fechaKey, fechaISO, semanaIdx, btn) {
  const texto = document.getElementById('vym-paste-area')?.value || '';
  if(!texto.trim()) { toast('Pega el texto primero'); return; }
  const fecha = new Date(fechaISO);
  const urlId = vymUrlPorFecha(fecha);
  const semana = vymParsearTexto(texto, fechaKey);
  semana.urlId = urlId;
  const asignExist = (getVymState().semanas[fechaKey]||{}).asign;
  getVymState().semanas[fechaKey] = semana;
  if(asignExist) getVymState().semanas[fechaKey].asign = asignExist;
  saveStateAndSync();
  btn.closest('[style*=fixed]').remove();
  renderVyM();
  toast('✓ Programa cargado');
}

function vymGetAsign(semKey, parteId, sala) {
  const s = getVymState().semanas[semKey];
  if(!s || !s.asign) return '';
  const sufijos = { prin:'', aux:'_aux', prin_ayud:'_prin_ayud', aux_ayud:'_aux_ayud' };
  return s.asign[parteId + (sufijos[sala]||'')] || '';
}

function vymSetAsign(semKey, parteId, sala, pubId) {
  const vym = getVymState();
  if(!vym.semanas[semKey]) return;
  if(!vym.semanas[semKey].asign) vym.semanas[semKey].asign = {};
  const sufijos = { prin:'', aux:'_aux', prin_ayud:'_prin_ayud', aux_ayud:'_aux_ayud' };
  const key = parteId + (sufijos[sala]||'');
  const anterior = vym.semanas[semKey].asign[key];
  vym.semanas[semKey].asign[key] = pubId;

  // Guardar en historial global
  if(!vym.historial) vym.historial = [];
  // Remover entrada previa de esta combinación semana+parte+sala
  vym.historial = vym.historial.filter(h => !(h.semKey===semKey && h.parteId===parteId && h.sala===sala));
  if(pubId) {
    const semana = vym.semanas[semKey];
    const parte = (semana?.partes||[]).find(p=>p.id===parteId);
    vym.historial.push({
      semKey, parteId, sala, pubId,
      nombreParte: parte?.nombre || parteId,
      fecha: semKey
    });
  }

  saveStateAndSync();
  vymMarcarDuplicados();
}

function vymMarcarDuplicados() {
  const hist = (getVymState().historial||[]);
  document.querySelectorAll('.vym-semana').forEach(sEl => {
    const semKey = sEl.dataset.semkey;
    if(!semKey) return;
    const asign = (getVymState().semanas[semKey]||{}).asign || {};

    // Conteo duplicados en misma semana
    const conteo = {};
    Object.values(asign).forEach(v => { if(v) conteo[v] = (conteo[v]||0)+1; });

    sEl.querySelectorAll('.vym-select').forEach(sel => {
      const pubId = sel.value;
      if(!pubId) { sel.style.borderColor=''; sel.style.background=''; sel.title=''; return; }

      const dup = conteo[pubId] > 1;

      // Verificar si participó hace menos de 3 semanas en OTRA semana
      const asignReciente = hist.filter(h => h.pubId===pubId && h.semKey!==semKey)
        .sort((a,b)=>b.fecha.localeCompare(a.fecha))[0];
      let reciente = false;
      if(asignReciente) {
        const semanas = Math.round((new Date(semKey)-new Date(asignReciente.fecha))/(7*24*3600*1000));
        reciente = Math.abs(semanas) < 3;
      }

      if(dup) {
        sel.style.borderColor='#ef4444'; sel.style.background='#fef2f2';
        sel.title='⚠ Ya tiene otra asignación esta semana';
      } else if(reciente) {
        sel.style.borderColor='#f59e0b'; sel.style.background='#fffbeb';
        sel.title=`⚠ Participó hace menos de 3 semanas (${asignReciente.semKey})`;
      } else {
        sel.style.borderColor=''; sel.style.background=''; sel.title='';
      }
    });
  });
}

function vymOpcionesSelect(rol, valorActual, parteNombre) {
  let pubs = [...state.publicadores].sort((a,b)=>a.apellido.localeCompare(b.apellido,'es'));
  if(rol === 'anciano')             pubs = pubs.filter(p=>p.anciano);
  else if(rol === 'anciano_siervo') pubs = pubs.filter(p=>p.anciano||p.siervo);

  // Calcular última asignación por pub para ordenar (rotación)
  const hist = (getVymState().historial||[]);
  const ultimaAsign = {};
  hist.forEach(h => {
    if(!ultimaAsign[h.pubId] || h.fecha > ultimaAsign[h.pubId]) {
      ultimaAsign[h.pubId] = h.fecha;
    }
  });

  // Ordenar: primero los que llevan más tiempo sin asignación
  pubs.sort((a,b) => {
    const fa = ultimaAsign[a.id] || '0000-00-00';
    const fb = ultimaAsign[b.id] || '0000-00-00';
    if(fa !== fb) return fa < fb ? -1 : 1;
    return a.apellido.localeCompare(b.apellido,'es');
  });

  const opts = ['<option value="">— Sin asignar —</option>'];
  const hoy = new Date().toISOString().slice(0,10);
  pubs.forEach((p,idx) => {
    const sel = p.id===valorActual ? ' selected':'';
    const ultima = ultimaAsign[p.id];
    let sufijo = '';
    if(!ultima) sufijo = ' ★';  // nunca asignado
    else {
      const semanas = Math.round((new Date(hoy)-new Date(ultima))/(7*24*3600*1000));
      if(semanas >= 6) sufijo = ` (${semanas}sem)`;
    }
    // Primer candidato de rotación
    const esProximo = idx === 0 && !valorActual;
    opts.push(`<option value="${p.id}"${sel}>${escHtml(p.apellido)}, ${escHtml(p.nombre)}${sufijo}</option>`);
  });
  return opts.join('');
}

function vymNombrePub(pubId) {
  if(!pubId) return '________________';
  const p = state.publicadores.find(x=>x.id===pubId);
  return p ? `${p.apellido}, ${p.nombre}` : '________________';
}

function vymFechaLabelSemKey(semKey) {
  for(let i=-4; i<20; i++) {
    const f = vymLunesDeSemana(i);
    if(vymSemanaKey(f) === semKey) return vymFechaLabel(f).toUpperCase();
  }
  return semKey;
}

function vymExportarSemana(semKey) {
  const vym = getVymState();
  const semana = vym.semanas[semKey];
  if(!semana) return;
  const fechaLabel = vymFechaLabelSemKey(semKey);

  // ── Construir HTML con formato idéntico al PDF oficial ──
  const grupos = {};
  (semana.partes||[]).forEach(p => {
    const s = p.seccion||'tesoros';
    if(!grupos[s]) grupos[s]=[];
    grupos[s].push(p);
  });

  // Colores exactos del PDF
  const TD = 'padding:5px 8px;vertical-align:top;';
  const SECC_COLORS = {
    tesoros:  { bg:'#1a5276', accent:'#d4ac0d', label:'TESOROS DE LA BIBLIA',    icon:'◆' },
    maestros: { bg:'#1a5276', accent:'#ca6f1e', label:'SEAMOS MEJORES MAESTROS', icon:'◈' },
    vida:     { bg:'#922b21', accent:'#922b21', label:'NUESTRA VIDA CRISTIANA',  icon:'♥' },
  };

  // Función para una fila de parte
  function filaHTML(parte, semKey) {
    const conAyud = parte.conAyudante ||
      (/Empiece conversaciones|Haga revisitas|Haga discípulos|Explique sus|Dé discursos/i.test(parte.nombre) &&
       !/discurso/i.test(parte.detalle||''));
    const prin     = vymNombrePub(vymGetAsign(semKey, parte.id, 'prin'));
    const prinAyud = conAyud ? vymNombrePub(vymGetAsign(semKey, parte.id, 'prin_ayud')) : '';
    const aux      = parte.doble ? vymNombrePub(vymGetAsign(semKey, parte.id, 'aux')) : '';
    const auxAyud  = conAyud && parte.doble ? vymNombrePub(vymGetAsign(semKey, parte.id, 'aux_ayud')) : '';

    const mins = parte.mins ? ` (${parte.mins} mins.)` : '';
    const detalle = parte.detalle ? `<br><span style="font-size:9.5px;color:#555;font-style:italic">${escHtml(parte.detalle)}</span>` : '';

    // Columna de asignados
    let asigCol = '';
    if(conAyud && parte.doble) {
      asigCol = `<td style="${TD}width:22%">
        <span style="font-size:8px;font-weight:700;color:#888;display:block;text-transform:uppercase;letter-spacing:.3px">Principal</span>
        <b>${prin}</b><br>
        <span style="font-size:9px;color:#666">Ayud: ${prinAyud}</span>
      </td>
      <td style="${TD}width:22%">
        <span style="font-size:8px;font-weight:700;color:#888;display:block;text-transform:uppercase;letter-spacing:.3px">Auxiliar</span>
        <b>${aux}</b><br>
        <span style="font-size:9px;color:#666">Ayud: ${auxAyud}</span>
      </td>`;
    } else if(parte.doble) {
      asigCol = `<td style="${TD}width:22%"><b>${prin}</b></td><td style="${TD}width:22%"><b>${aux}</b></td>`;
    } else if(parte.esLector) {
      asigCol = `<td colspan="2" style="${TD}"><span style="color:#888;font-style:italic">${prin}</span></td>`;
    } else {
      asigCol = `<td colspan="2" style="${TD}"><b>${prin}</b></td>`;
    }

    const bgRow = parte.esLector ? 'background:#fafafa' : '';
    const nameStyle = parte.esLector
      ? `font-size:10px;color:#aaa;font-style:italic`
      : `font-size:11px;color:#1a1a1a;font-weight:500`;

    return `<tr style="border-bottom:1px solid #e8e8e8;${bgRow}">
      <td style="${TD}width:56%">
        <span style="${nameStyle}">${escHtml(parte.nombre)}${mins}</span>${detalle}
      </td>
      ${asigCol}
    </tr>`;
  }

  // Fila encabezado apertura
  const canAp = semana.cancionApertura ? `Canción ${semana.cancionApertura} y oración` : '';
  const canCi = semana.cancionCierre   ? `Canción ${semana.cancionCierre} y oración`   : '';

  let htmlContent = '';

  // ── ENCABEZADO APERTURA ──
  htmlContent += `<table width="100%" style="border-collapse:collapse;margin-bottom:2px">
    <tr style="border-bottom:1px solid #ccc">
      <td style="padding:5px 8px;font-size:10.5px;color:#333">
        ${canAp ? `<b>♩ ${escHtml(canAp)}</b>  |  ` : ''}
        <b>Palabras de introducción</b> <span style="font-weight:400">(1 min.)</span>
      </td>
      <td style="padding:5px 8px;text-align:right;font-size:10px;color:#888">
        ${semana.libros ? `<b style="color:#1a5276">${escHtml(semana.libros)}</b>` : ''}
      </td>
    </tr>
  </table>`;

  // ── PRESIDENTE ──
  const pres = (grupos.apertura||[]).find(p=>p.id==='presidente');
  if(pres) {
    const presNombre = vymNombrePub(vymGetAsign(semKey, 'presidente', 'prin'));
    htmlContent += `<table width="100%" style="border-collapse:collapse;margin-bottom:6px">
      <tr style="border-bottom:1px solid #eee">
        <td style="${TD}font-size:11px;width:56%"><b>Presidente de la reunión</b></td>
        <td colspan="2" style="${TD}font-size:11px"><b>${presNombre}</b></td>
      </tr>
    </table>`;
  }

  // ── SECCIONES PRINCIPALES ──
  ['tesoros','maestros','vida'].forEach(secId => {
    const partes = grupos[secId]; if(!partes||!partes.length) return;
    const cfg = SECC_COLORS[secId];

    htmlContent += `
    <table width="100%" style="border-collapse:collapse;margin-bottom:8px;border:1px solid #ddd;border-radius:4px;overflow:hidden">
      <tr>
        <td colspan="3" style="background:${cfg.bg};padding:5px 8px">
          <span style="color:#fff;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.8px">${cfg.label}</span>
        </td>
      </tr>`;

    partes.forEach(parte => { htmlContent += filaHTML(parte, semKey); });
    htmlContent += `</table>`;
  });

  // ── CIERRE ──
  const cierrePartes = grupos.cierre || [];
  htmlContent += `<table width="100%" style="border-collapse:collapse;margin-top:4px">
    <tr style="border-top:1px solid #ccc">
      <td style="padding:5px 8px;font-size:10.5px;color:#333">
        <b>Palabras de conclusión</b> <span style="font-weight:400">(3 mins.)</span>
        ${canCi ? `  |  <b>♩ ${escHtml(canCi)}</b>` : ''}
      </td>
      <td style="padding:5px 8px;text-align:right">
        ${cierrePartes.length ? `<b style="font-size:11px">${vymNombrePub(vymGetAsign(semKey, cierrePartes[0].id, 'prin'))}</b>` : ''}
      </td>
    </tr>
  </table>`;

  const html = `<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8">
<title>Vida y Ministerio — ${fechaLabel}</title>
<style>
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:"Arial",sans-serif; background:#fff; color:#111; padding:14px 16px; max-width:720px; margin:0 auto; font-size:11px; }
  .page-header { border-bottom:3px solid #1a5276; padding-bottom:8px; margin-bottom:10px; }
  .page-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; color:#555; }
  .page-fecha { font-size:17px; font-weight:900; color:#1a1a1a; margin:3px 0; letter-spacing:-.3px; }
  .page-libros { font-size:12px; font-weight:700; color:#1a5276; }
  .no-print { text-align:center; margin-top:14px; }
  .btn-print { padding:9px 24px; background:#1a5276; color:#fff; border:none; border-radius:6px; font-size:12px; font-weight:700; cursor:pointer; font-family:Arial,sans-serif; }
  @media print {
    body { padding:8px; }
    .no-print { display:none !important; }
    table { page-break-inside:avoid; }
  }
</style>
</head>
<body>
  <div class="page-header">
    <div class="page-title">VIDA Y MINISTERIO CRISTIANOS</div>
    <div class="page-fecha">${fechaLabel}</div>
    ${semana.libros ? `<div class="page-libros">${escHtml(semana.libros)}</div>` : ''}
  </div>
  ${htmlContent}
  <div class="no-print">
    <button class="btn-print" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>
  </div>
</body></html>`;

  const win = window.open('', '_blank');
  win.document.write(html);
  win.document.close();
  toast('✓ Programa abierto — usa Imprimir para guardar como PDF');
}

// ── HISTORIAL DE ASIGNACIONES ──
function vymMostrarHistorial() {
  const vym = getVymState();
  const hist = (vym.historial||[]).slice().sort((a,b)=>b.fecha.localeCompare(a.fecha));

  // Agrupar por publicador
  const porPub = {};
  hist.forEach(h => {
    if(!porPub[h.pubId]) porPub[h.pubId] = [];
    porPub[h.pubId].push(h);
  });

  // Ordenar pubs: más reciente primero
  const pubsSorted = Object.entries(porPub).sort((a,b) => {
    return b[1][0].fecha.localeCompare(a[1][0].fecha);
  });

  const hoy = new Date();

  let filas = pubsSorted.map(([pubId, asigns]) => {
    const pub = state.publicadores.find(p=>p.id===pubId);
    const nombre = pub ? `${pub.apellido}, ${pub.nombre}` : pubId;
    const ultima = asigns[0].fecha;
    const semanasAtras = Math.round((hoy - new Date(ultima)) / (7*24*3600*1000));
    const badge = semanasAtras < 3
      ? `<span style="background:#fef3c7;color:#92400e;font-size:9px;font-weight:700;padding:1px 6px;border-radius:10px">Reciente (${semanasAtras}sem)</span>`
      : semanasAtras > 8
      ? `<span style="background:#d1fae5;color:#065f46;font-size:9px;font-weight:700;padding:1px 6px;border-radius:10px">Disponible</span>`
      : '';
    const partes = [...new Set(asigns.map(a=>a.nombreParte))].slice(0,3).join(', ');
    return `<tr style="border-bottom:1px solid var(--border-2)">
      <td style="padding:8px 12px;font-size:12px;font-weight:600">${nombre}</td>
      <td style="padding:8px 8px;font-size:11px;color:var(--ink-3)">${ultima} ${badge}</td>
      <td style="padding:8px 8px;font-size:11px;color:var(--ink-3)">${asigns.length}x</td>
      <td style="padding:8px 12px;font-size:10px;color:var(--ink-3);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${partes}</td>
    </tr>`;
  }).join('');

  // Hermanos que NUNCA han participado
  const participaron = new Set(hist.map(h=>h.pubId));
  const nunca = state.publicadores.filter(p=>!participaron.has(p.id));
  if(nunca.length) {
    filas += `<tr><td colspan="4" style="padding:6px 12px;background:#fef2f2;font-size:10px;font-weight:700;color:#991b1b;text-transform:uppercase;letter-spacing:.5px">
      Sin asignación aún (${nunca.length})
    </td></tr>`;
    nunca.forEach(p => {
      filas += `<tr style="border-bottom:1px solid var(--border-2);background:#fef2f2">
        <td style="padding:6px 12px;font-size:12px;font-weight:600;color:#991b1b">${p.apellido}, ${p.nombre}</td>
        <td colspan="3" style="padding:6px 8px;font-size:11px;color:#9ca3af">Nunca asignado ★</td>
      </tr>`;
    });
  }

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px';
  overlay.innerHTML = `
    <div style="background:var(--surface);border-radius:16px;max-width:700px;width:100%;max-height:90vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3)">

function renderMetricas(tab) {
  if(tab==='resumen')       renderMetResumen();
  if(tab==='mensual')       renderMetMensual();
  if(tab==='publicadores')  renderMetPublicadores();
}

function getAnioMetrica() { return mesActual().anio; }

function renderMetResumen() {
  const el = document.getElementById('mtab-body-resumen');
  try {
    const pubs = state.publicadores;
    const total = pubs.length;
    if(!total) { el.innerHTML = '<div style="padding:40px;text-align:center;color:#aaa">No hay publicadores registrados.</div>'; return; }

    const anio = getAnioMetrica();
    const ma = mesActual();
    const mesCV = ma.mesC, mesNombre = ma.mesNombre, anioMes = ma.anio;
    const infoMes = mesVencidoInfo();

    // Composición
    const nAncianos   = pubs.filter(p=>p.anciano).length;
    const nSiervos    = pubs.filter(p=>p.siervo&&!p.anciano).length;
    const nPrecReg    = pubs.filter(p=>p.precursorReg).length;
    const nPrecEsp    = pubs.filter(p=>p.precursorEsp).length;
    const nMisioneros = pubs.filter(p=>p.misionero).length;
    const nPublicad   = pubs.filter(p=>!p.anciano&&!p.siervo&&!p.precursorReg&&!p.precursorEsp&&!p.misionero).length;

    // Totales año
    let horasTotal = 0, cursosTotal = 0;
    pubs.forEach(p => MESES_C.forEach(m => {
      const r = p.registros&&p.registros[anio]&&p.registros[anio][m];
      if(r){ horasTotal += parseFloat(r.horas)||0; cursosTotal += parseInt(r.cursos)||0; }
    }));

    // Mes vencido
    const informaron   = pubs.filter(p => { const r=p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesCV]; return r&&r.particip; });
    const noInformaron = pubs.filter(p => { const r=p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesCV]; return !r||!r.particip; });
    const nPaux        = pubs.filter(p => { const r=p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesCV]; return r&&r.paux; }).length;
    const pct = total ? Math.round(informaron.length/total*100) : 0;

    // Barras composición
    const cats = [
      {label:'Ancianos', n:nAncianos, color:'#2563eb'},
      {label:'Siervos ministeriales', n:nSiervos, color:'#16a34a'},
      {label:'Precursores regulares', n:nPrecReg, color:'#b45309'},
      {label:'Precursores especiales', n:nPrecEsp, color:'#7c3aed'},
      {label:'Misioneros', n:nMisioneros, color:'#be185d'},
      {label:'Publicadores', n:nPublicad, color:'#64748b'},
    ].filter(c=>c.n>0);
    const maxCat = Math.max(...cats.map(c=>c.n), 1);

    // Construir HTML
    let html = '';

    // Banner
    html += '<div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:8px 14px;margin-bottom:14px;font-size:11px;color:#1e40af">';
    html += '&#128203; ' + infoMes;
    html += '</div>';

    // KPIs fila 1
    html += '<div class="met-kpi-grid">';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#2563eb">' + total + '</div><div class="met-kpi-l">Publicadores</div><div class="met-kpi-sub">total registrados</div></div>';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#16a34a">' + pct + '%</div><div class="met-kpi-l">Informaron &middot; ' + mesNombre + '</div><div class="met-kpi-sub">' + informaron.length + ' de ' + total + '</div></div>';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#ef4444">' + noInformaron.length + '</div><div class="met-kpi-l">Sin informe &middot; ' + mesNombre + '</div><div class="met-kpi-sub">' + (noInformaron.length===0?'&#10003; Todos informaron':'Pendientes') + '</div></div>';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#7c3aed">' + nPaux + '</div><div class="met-kpi-l">Prec. auxiliares</div><div class="met-kpi-sub">en ' + mesNombre + '</div></div>';
    html += '</div>';

    // KPIs fila 2
    html += '<div class="met-kpi-grid" style="grid-template-columns:repeat(2,1fr)">';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#b45309">' + Math.round(horasTotal) + '</div><div class="met-kpi-l">Horas totales</div><div class="met-kpi-sub">a&ntilde;o ' + anio + '-' + (anio+1) + '</div></div>';
    html += '<div class="met-kpi"><div class="met-kpi-n" style="color:#0891b2">' + cursosTotal + '</div><div class="met-kpi-l">Cursos b&iacute;blicos</div><div class="met-kpi-sub">a&ntilde;o ' + anio + '-' + (anio+1) + '</div></div>';
    html += '</div>';

    // Listas informaron / no informaron
    html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px">';

    // Columna informaron
    html += '<div>';
    html += '<div class="met-section-title" style="color:#16a34a">&#10003; Informaron (' + informaron.length + ')</div>';
    html += '<div style="display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto">';
    informaron.sort((a,b)=>a.apellido.localeCompare(b.apellido,'es')).forEach(p => {
      const r = p.registros&&p.registros[anioMes]&&p.registros[anioMes][mesCV];
      const det = [];
      if(r&&r.horas) det.push(r.horas+'h');
      if(r&&r.cursos) det.push(r.cursos+'c');
      if(r&&r.paux) det.push('PA');
      html += '<div style="font-size:11px;padding:3px 8px;background:#f0fdf4;border-radius:4px;display:flex;justify-content:space-between">';
      html += '<span>' + escHtml(p.apellido) + ', ' + escHtml(p.nombre) + '</span>';
      html += '<span style="color:#16a34a;font-size:10px">' + det.join(' ') + '</span>';
      html += '</div>';
    });
    html += '</div></div>';

    // Columna no informaron
    html += '<div>';
    html += '<div class="met-section-title" style="color:#ef4444">&#10007; Sin informe (' + noInformaron.length + ')</div>';
    html += '<div style="display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto">';
    noInformaron.sort((a,b)=>a.apellido.localeCompare(b.apellido,'es')).forEach(p => {
      html += '<div style="font-size:11px;padding:3px 8px;background:#fef2f2;border-radius:4px">';
      html += escHtml(p.apellido) + ', ' + escHtml(p.nombre);
      html += '</div>';
    });
    html += '</div></div>';
    html += '</div>';

    // Barras composición
    html += '<div class="met-section-title" style="margin-top:16px">Composici&oacute;n de la congregaci&oacute;n</div>';
    cats.forEach(c => {
      html += '<div class="met-bar-row">';
      html += '<div class="met-bar-label">' + c.label + '</div>';
      html += '<div class="met-bar-track"><div class="met-bar-fill" style="width:' + Math.round(c.n/maxCat*100) + '%;background:' + c.color + '"></div></div>';
      html += '<div class="met-bar-val" style="color:' + c.color + '">' + c.n + '</div>';
      html += '</div>';
    });

    el.innerHTML = html;
  } catch(e) {
    el.innerHTML = '<div style="padding:20px;color:red;font-size:12px">Error: ' + e.message + '</div>';
    console.error('renderMetResumen error:', e);
  }
}

function renderMetMensual() {
  const anio = getAnioMetrica();
  const pubs = state.publicadores;
  const el = document.getElementById('mtab-body-mensual');
  if(!pubs.length) { el.innerHTML = '<div style="padding:40px;text-align:center;color:#aaa">No hay datos.</div>'; return; }

  // Mes a reportar (vencido)
  const { mesC: mesCV, mesNombre, anio: anioMes, idx: mesIdx } = mesActual();

  // ── Calcular "Publicadores activos" según regla oficial:
  // Personas que informaron participación UN MES O MÁS durante los ÚLTIMOS 6 MESES
  function pubsActivosUltimos6(desdeIdx) {
    const activos = new Set();
    for(let i = 0; i <= 5; i++) {
      const idx = ((desdeIdx - i) + 12) % 12;
      const m = MESES_C[idx];
      // Si el mes anterior idx < mesIdx estamos en el mismo año, si no en el anterior
      const anioMes2 = idx <= mesIdx ? anioMes : anioMes - 1;
      pubs.forEach(p => {
        const r = (p.registros||{})[anioMes2]?.[m] || (p.registros||{})[String(anioMes2)]?.[m];
        if(r && r.particip) activos.add(p.id);
      });
    }
    return activos.size;
  }
  const pubsActivos6 = pubsActivosUltimos6(mesIdx);

  // ── Calcular datos del mes actual para el informe ──
  function calcMes(m, anioR) {
    const precReg  = pubs.filter(p => p.precursorReg || p.precursorEsp || p.misionero);
    const precAux  = pubs.filter(p => !p.precursorReg && !p.precursorEsp && !p.misionero);

    const getReg = (p) => (p.registros||{})[anioR]?.[m] || (p.registros||{})[String(anioR)]?.[m];

    // Publicadores (no precursores regulares/especiales/misioneros)
    const pubsSolo = pubs.filter(p => !p.precursorReg && !p.precursorEsp && !p.misionero && !p.paux);
    // Precursores auxiliares = publicadores con paux=true ese mes
    const pauxList = pubs.filter(p => { const r = getReg(p); return r && r.paux && !p.precursorReg && !p.precursorEsp && !p.misionero; });

    // Publicadores (excluye paux del mes, precReg, precEsp, misionero)
    const pubsInforme = pubs.filter(p => {
      if(p.precursorReg || p.precursorEsp || p.misionero) return false;
      const r = getReg(p);
      if(r && r.paux) return false; // este mes es paux
      return r && r.particip;
    });

    let hPub=0, cPub=0;
    pubsInforme.forEach(p => { const r=getReg(p); if(r){hPub+=parseFloat(r.horas)||0; cPub+=parseInt(r.cursos)||0;} });

    let hPaux=0, cPaux=0;
    pauxList.forEach(p => { const r=getReg(p); if(r){hPaux+=parseFloat(r.horas)||0; cPaux+=parseInt(r.cursos)||0;} });

    let hPrec=0, cPrec=0;
    const precInforme = precReg.filter(p => { const r=getReg(p); return r && r.particip; });
    precInforme.forEach(p => { const r=getReg(p); if(r){hPrec+=parseFloat(r.horas)||0; cPrec+=parseInt(r.cursos)||0;} });

    return {
      pubsInforme: pubsInforme.length,
      hPub: Math.round(hPub), cPub,
      pauxInforme: pauxList.length,
      hPaux: Math.round(hPaux), cPaux,
      precInforme: precInforme.length,
      hPrec: Math.round(hPrec), cPrec,
    };
  }

  const d = calcMes(mesCV, anioMes);

  // Asistencia promedio fin de semana (de módulo de asistencia)
  const asistFDS = (state.asistencia||[])
    .filter(r => r.tipo === 'Fin de semana')
    .map(r => (parseInt(r.presencial)||0) + (parseInt(r.zoom)||0));
  const promFDS = asistFDS.length ? Math.round(asistFDS.reduce((s,v)=>s+v,0)/asistFDS.length) : null;

  // ── HTML del Informe Oficial ──
  const TD  = 'padding:9px 14px;border-bottom:1px solid var(--border-2);font-size:13px;';
  const TDN = 'padding:9px 14px;border-bottom:1px solid var(--border-2);font-size:16px;font-weight:800;font-family:Sora,var(--font);text-align:center;color:var(--accent);';
  const TH  = 'padding:8px 14px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--ink-3);background:var(--surface-2);border-bottom:1px solid var(--border);';
  const SEC = 'padding:8px 14px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:var(--accent);background:var(--accent-lt);border-bottom:1px solid var(--accent-mid);';

  let informe = '';
  informe += '<div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--sh)">';

  // Header del informe
  informe += '<div style="background:linear-gradient(135deg,var(--accent),var(--accent-dk));color:#fff;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">';
  informe += '<div><div style="font-family:Sora,var(--font);font-size:15px;font-weight:800;letter-spacing:-.2px">Informe de la Congregaci\u00f3n</div>';
  informe += '<div style="font-size:12px;opacity:.8;margin-top:2px">' + mesNombre + ' ' + anioMes + '\u2013' + (anioMes+1) + '</div></div>';
  informe += '<button onclick="exportarInformeMes()" style="background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);color:#fff;padding:6px 14px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;font-family:var(--font)">📋 Exportar</button>';
  informe += '</div>';

  informe += '<table style="width:100%;border-collapse:collapse">';
  informe += '<colgroup><col style="width:60%"><col style="width:40%"></colgroup>';

  // Publicadores activos
  informe += '<tr><td style="' + TDN + 'text-align:left;padding-left:20px;font-size:13px;color:var(--ink);font-weight:700;font-family:var(--font)">Publicadores activos <span style="font-size:11px;color:var(--ink-3);font-weight:500">(informaron 1+ mes en los \u00faltimos 6)</span></td>';
  informe += '<td style="' + TDN + '">' + pubsActivos6 + '</td></tr>';

  // Asistencia fin de semana
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Promedio de asistencia a las reuniones del fin de semana</td>';
  informe += '<td style="' + TDN + '">' + (promFDS !== null ? promFDS : '<span style="font-size:12px;color:var(--ink-3)">—</span>') + '</td></tr>';

  // Sección Publicadores
  informe += '<tr><td colspan="2" style="' + SEC + '">Publicadores</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cantidad de informes</td><td style="' + TDN + '">' + d.pubsInforme + '</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cursos b\u00edblicos</td><td style="' + TDN + '">' + d.cPub + '</td></tr>';

  // Sección Precursores auxiliares
  informe += '<tr><td colspan="2" style="' + SEC + '">Precursores auxiliares</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cantidad de informes</td><td style="' + TDN + '">' + d.pauxInforme + '</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Horas</td><td style="' + TDN + '">' + d.hPaux + '</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cursos b\u00edblicos</td><td style="' + TDN + '">' + d.cPaux + '</td></tr>';

  // Sección Precursores regulares
  informe += '<tr><td colspan="2" style="' + SEC + '">Precursores regulares</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cantidad de informes</td><td style="' + TDN + '">' + d.precInforme + '</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Horas</td><td style="' + TDN + '">' + d.hPrec + '</td></tr>';
  informe += '<tr><td style="' + TD + 'color:var(--ink-2)">Cursos b\u00edblicos</td><td style="' + TDN + '">' + d.cPrec + '</td></tr>';

  informe += '</table>';
  informe += '<div style="padding:10px 20px;font-size:10px;color:var(--ink-3);border-top:1px solid var(--border-2)">Generado autom\u00e1ticamente · Datos sujetos a los informes registrados en la app</div>';
  informe += '</div>';

  // ── Historial por mes (cards) ──
  const cards = MESES_C.map((m,i) => {
    const r = calcMes(m, anioMes);
    const esMesActual = i === mesIdx;
    return '<div class="met-mes-card" style="' + (esMesActual?'border:2px solid var(--accent);':'') + '">'
      + '<div class="met-mes-nombre">' + MESES[i] + (esMesActual?' <span style="font-size:8px;background:var(--accent);color:#fff;padding:1px 5px;border-radius:10px;vertical-align:middle">actual</span>':'') + '</div>'
      + '<div class="met-mes-stat"><div class="met-mes-n" style="color:var(--accent)">' + (r.pubsInforme+r.pauxInforme+r.precInforme) + '</div><div class="met-mes-l">informes</div></div>'
      + '<div class="met-mes-stat"><div class="met-mes-n" style="color:#7c3aed">' + r.pauxInforme + '</div><div class="met-mes-l">prec. aux.</div></div>'
      + '<div class="met-mes-stat"><div class="met-mes-n" style="color:#b45309">' + (r.hPub+r.hPaux+r.hPrec) + '</div><div class="met-mes-l">horas</div></div>'
      + '<div class="met-mes-stat"><div class="met-mes-n" style="color:#0891b2">' + (r.cPub+r.cPaux+r.cPrec) + '</div><div class="met-mes-l">cursos</div></div>'
      + '</div>';
  }).join('');

  el.innerHTML = '<div style="padding:4px 0 16px">' + informe + '</div>'
    + '<div style="font-size:11px;font-weight:700;color:var(--ink-3);text-transform:uppercase;letter-spacing:.8px;margin:20px 0 10px">Historial del a\u00f1o ' + anio + '\u2013' + (anio+1) + '</div>'
    + '<div class="met-mes-grid">' + cards + '</div>';
}

function exportarInformeMes() {
  const { mesC: mesCV, mesNombre, anio: anioMes, idx: mesIdx } = mesActual();
  const pubs = state.publicadores;
  const anio = getAnioMetrica();

  function getReg(p, m, a) { return (p.registros||{})[a]?.[m] || (p.registros||{})[String(a)]?.[m]; }

  // Publicadores activos últimos 6 meses
  const activos6 = new Set();
  for(let i=0; i<=5; i++){
    const idx = ((mesIdx-i)+12)%12;
    const m = MESES_C[idx];
    const a2 = idx<=mesIdx ? anioMes : anioMes-1;
    pubs.forEach(p=>{ const r=getReg(p,m,a2); if(r&&r.particip) activos6.add(p.id); });
  }

  const pauxList = pubs.filter(p => { const r=getReg(p,mesCV,anioMes); return r&&r.paux&&!p.precursorReg&&!p.precursorEsp&&!p.misionero; });
  const precList = pubs.filter(p => (p.precursorReg||p.precursorEsp||p.misionero) && (()=>{ const r=getReg(p,mesCV,anioMes); return r&&r.particip; })() );
  const pubList  = pubs.filter(p => { if(p.precursorReg||p.precursorEsp||p.misionero) return false; const r=getReg(p,mesCV,anioMes); return r&&r.particip&&!r.paux; });

  let h = (n,v='') => '<tr><td style="padding:7px 12px;border-bottom:1px solid #f0f0f0;font-size:12px;color:#555;width:65%">'+n+'</td><td style="padding:7px 12px;border-bottom:1px solid #f0f0f0;font-size:15px;font-weight:800;text-align:center;color:#3d5a9e">'+v+'</td></tr>';
  let s = (n) => '<tr><td colspan="2" style="padding:7px 12px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:#3d5a9e;background:#eef1f9;border-bottom:1px solid #b8c4e0">'+n+'</td></tr>';

  const asistFDS = (state.asistencia||[]).filter(r=>r.tipo==='Fin de semana').map(r=>(parseInt(r.presencial)||0)+(parseInt(r.zoom)||0));
  const promFDS = asistFDS.length ? Math.round(asistFDS.reduce((s,v)=>s+v,0)/asistFDS.length) : '—';

  let sum = (list,f) => list.reduce((s,p)=>{ const r=getReg(p,mesCV,anioMes); return s+(r?f(r):0); },0);

  const html = `<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">
<title>Informe ${mesNombre} ${anioMes}</title>
<style>body{font-family:Arial,sans-serif;margin:0;padding:20px;color:#111}table{width:100%;border-collapse:collapse}
.no-print{margin-bottom:16px}@media print{.no-print{display:none}}</style></head>
<body>
<div class="no-print"><button onclick="window.print()" style="background:#3d5a9e;color:#fff;border:none;padding:8px 20px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer">🖨 Imprimir / PDF</button></div>
<div style="border-bottom:3px solid #3d5a9e;padding-bottom:10px;margin-bottom:16px">
  <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#888">Informe de la Congregación</div>
  <div style="font-size:22px;font-weight:900;color:#1a1814;margin-top:3px">${mesNombre} ${anioMes}–${anioMes+1}</div>
</div>
<table>
${h('Publicadores activos (1+ mes en últimos 6)', activos6.size)}
${h('Promedio de asistencia reuniones fin de semana', promFDS)}
${s('Publicadores')}
${h('Cantidad de informes', pubList.length)}
${h('Cursos bíblicos', sum(pubList,r=>parseInt(r.cursos)||0))}
${s('Precursores auxiliares')}
${h('Cantidad de informes', pauxList.length)}
${h('Horas', Math.round(sum(pauxList,r=>parseFloat(r.horas)||0)))}
${h('Cursos bíblicos', sum(pauxList,r=>parseInt(r.cursos)||0))}
${s('Precursores regulares')}
${h('Cantidad de informes', precList.length)}
${h('Horas', Math.round(sum(precList,r=>parseFloat(r.horas)||0)))}
${h('Cursos bíblicos', sum(precList,r=>parseInt(r.cursos)||0))}
</table>
<p style="margin-top:20px;font-size:10px;color:#aaa;text-align:center">Congregación · S-21 · Generado el ${new Date().toLocaleDateString('es')}</p>
</body></html>`;

  const win = window.open('','_blank');
  win.document.write(html);
  win.document.close();
  toast('✓ Informe abierto — usa Imprimir para guardar como PDF');
}

function renderMetPublicadores() {
  const anio = getAnioMetrica();
  const pubs = [...state.publicadores].sort((a,b)=>a.apellido.localeCompare(b.apellido));
  if(!pubs.length) { document.getElementById('mtab-body-publicadores').innerHTML = '<div style="padding:40px;text-align:center;color:#aaa">No hay datos.</div>'; return; }

  const filas = pubs.map(p => {
    const tipo  = tipoPrincipal(p);
    const col   = TIPO_COLOR[tipo]||'#64748b';
    let horasTotal = 0, cursosTotal = 0, pauxMeses = 0, mesesActivos = 0;
    MESES_C.forEach(m=>{
      const r=p.registros&&p.registros[anio]&&p.registros[anio][m];
      if(!r) return;
      if(r.particip) mesesActivos++;
      if(r.paux) pauxMeses++;
      if(r.horas) horasTotal+=parseFloat(r.horas)||0;
      if(r.cursos) cursosTotal+=parseInt(r.cursos)||0;
    });

    // Celdas por mes (participación)
    const celds = MESES_C.map(m=>{
      const r=p.registros&&p.registros[anio]&&p.registros[anio][m];
      const ok = r&&r.particip;
      const paux = r&&r.paux;
      return `<td>${ok ? (paux?'<span style="color:#7c3aed;font-weight:800">P</span>':'<span class="met-check">✓</span>') : '<span class="met-cross">-</span>'}</td>`;
    }).join('');

    const noPredico = mesesActivos === 0;
    return `<tr class="${noPredico?'met-no-pred':''}">
      <td>
        <div style="font-weight:600;font-size:12px">${escHtml(p.apellido)}, ${escHtml(p.nombre)}</div>
        <span class="met-badge-sm" style="background:${col}18;color:${col}">${tipo}</span>
      </td>
      ${celds}
      <td style="font-weight:700;color:#b45309">${pauxMeses||'-'}</td>
      <td style="font-weight:700;color:#16a34a">${Math.round(horasTotal)||'-'}</td>
      <td style="font-weight:700;color:#0891b2">${cursosTotal||'-'}</td>
    </tr>`;
  }).join('');

  const thMeses = MESES_C.map(m=>`<th>${m}</th>`).join('');

  document.getElementById('mtab-body-publicadores').innerHTML = `
    <div style="font-size:12px;color:#888;margin-bottom:14px">
      Año ${anio}-${anio+1} · <span style="color:#ef4444">Rojo</span> = no predicó ningún mes · 
      <span style="color:#7c3aed;font-weight:700">P</span> = Precursor auxiliar
    </div>
    <div style="overflow-x:auto">
      <div class="met-pub-table-wrap"><table class="met-pub-table">
        <thead>
          <tr>
            <th>Publicador</th>
            ${thMeses}
            <th>P.Aux</th>
            <th>Horas</th>
            <th>Cursos</th>
          </tr>
        </thead>
        <tbody>${filas}</tbody>
      </table>
    </div>
  `;
}


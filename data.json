// ══════════════════════════════════════════════════════════════
// MÓDULO PRECURSORES REGULARES
// ══════════════════════════════════════════════════════════════

const PREC_META_MES  = 50;
const PREC_META_ANIO = 560;

const PREC_LIMITE_BETEL = 55; // horas máx acreditables al combinar predicación + betel

function precGetDatos(pub, anio) {
  const regs = pub.registros || {};
  const meses = [];
  let horasTotal = 0, mesesConDatos = 0;
  let horasBetelBruto = 0;
  let horasBetelCredito = 0;
  let horasTotalCombinado = 0; // predicación + betel crédito

  MESES_C.forEach((m, idx) => {
    const r = (regs[anio] || regs[String(anio)] || {})[m];
    const horas = r ? (parseFloat(r.horas) || 0) : null;
    if(horas !== null) { mesesConDatos++; horasTotal += horas; }

    // Betel bruto del comentario
    const bruto = r?.notas ? _extraerHorasBetel(r.notas) : 0;

    // Crédito acreditable ese mes: min(bruto, max(0, 55 - horas_predicacion))
    let credito = 0;
    if(bruto > 0 && horas !== null) {
      const espacio = Math.max(0, PREC_LIMITE_BETEL - horas);
      credito = Math.min(bruto, espacio);
    }

    if(bruto)   horasBetelBruto   += bruto;
    if(credito) horasBetelCredito += credito;

    // Total combinado por mes (lo que cuenta para la meta)
    const combinado = horas !== null ? horas + credito : null;
    if(combinado !== null) horasTotalCombinado += combinado;

    meses.push({ mes:m, idx, horas, tieneDatos: horas !== null, betelBruto: bruto, betelCredito: credito, combinado });
  });

  // Todos los cálculos de meta se hacen sobre el total COMBINADO
  const promedio = mesesConDatos > 0 ? horasTotalCombinado / mesesConDatos : 0;
  const mesActualIdx = mesActual().idx;
  const mesesPasados = meses.filter(m => m.idx <= mesActualIdx);
  const mesesRestantes = 12 - mesesPasados.length;
  const horasRestantes = Math.max(0, PREC_META_ANIO - horasTotalCombinado);
  const promedioNecesario = mesesRestantes > 0 ? horasRestantes / mesesRestantes : 0;
  const ultimos3 = mesesPasados.slice(-3).filter(m => m.tieneDatos);
  const promUlt3 = ultimos3.length > 0
    ? ultimos3.reduce((s,m) => s + (m.combinado ?? m.horas), 0) / ultimos3.length
    : null;
  const requiereReunion = promUlt3 !== null && promUlt3 < PREC_META_MES && ultimos3.length >= 2;
  let estado = 'ok';
  if(requiereReunion) estado = 'reunion';
  else if(promedioNecesario > 70) estado = 'riesgo';
  else if(promedio < PREC_META_MES && mesesConDatos >= 2) estado = 'bajo';

  return { meses, horasTotal, horasTotalCombinado, promedio, mesesConDatos, mesesRestantes,
           horasRestantes, promedioNecesario, promUlt3, requiereReunion, estado,
           horasBetelBruto, horasBetelCredito };
}

// Extrae horas Betel de un comentario: "48 Betel", "HORAS BETEL 32", "32 horas betel", etc.
function _extraerHorasBetel(notas) {
  if(!notas) return 0;
  const txt = notas.toLowerCase();
  if(!txt.includes('betel')) return 0;
  const m = txt.match(/(\d+(?:\.\d+)?)\s*(?:horas?\s*)?betel|betel\s*(?:horas?\s*)?(\d+(?:\.\d+)?)/);
  if(m) return parseFloat(m[1] || m[2]) || 0;
  const n = txt.match(/\d+(?:\.\d+)?/);
  return n ? parseFloat(n[0]) : 0;
}

function precAbrirRegistro(pubId) {
  irA('publicadores');
  // Pequeño delay para que la pantalla cargue antes de seleccionar
  setTimeout(() => {
    selPub(pubId);
    // Scroll al pub en la lista
    const el = document.getElementById('pub-' + pubId);
    if(el) el.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }, 80);
}

function renderPrecursores() {
  const root = document.getElementById('precursores-root');
  if(!root) return;
  const anio = anioHoy();
  const precursores = state.publicadores.filter(p=>p.precursorReg)
    .sort((a,b)=>a.apellido.localeCompare(b.apellido,'es'));

  if(!precursores.length) {
    root.innerHTML = '<div style="padding:60px;text-align:center;color:var(--ink-3)">No hay precursores regulares registrados.</div>';
    return;
  }

  const datos = precursores.map(p => ({ pub:p, d:precGetDatos(p, anio) }));
  const nReunion = datos.filter(x=>x.d.requiereReunion).length;
  const nRiesgo  = datos.filter(x=>x.d.estado==='riesgo').length;
  const nOk      = datos.filter(x=>x.d.estado==='ok').length;
  const totalHorasBetel = datos.reduce((s,x) => s + x.d.horasBetelCredito, 0);
  const totalHorasBetelBruto = datos.reduce((s,x) => s + x.d.horasBetelBruto, 0);

  let html = '<div class="prec-wrap">';
  html += '<div class="prec-header">';
  html += '<div>';
  html += '<div class="prec-title">Precursores Regulares</div>';
  html += '<div class="prec-subtitle">A\u00f1o de servicio ' + anio + '\u2013' + (anio+1) + ' \u00b7 Meta mensual: <strong>' + PREC_META_MES + 'h</strong> \u00b7 Meta anual: <strong>' + PREC_META_ANIO + 'h</strong></div>';
  html += '</div>';
  html += '<div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-3)">';
  html += '<span style="background:var(--accent-lt);color:var(--accent);padding:4px 10px;border-radius:20px;font-weight:700;font-size:11px">' + precursores.length + ' precursore' + (precursores.length===1?'':'s') + '</span>';
  html += '</div>';
  html += '</div>';

  // Resumen ejecutivo — cards
  const summaryCards = [
    { n:nReunion, lbl:'Reuni\u00f3n requerida', icon:'\u26a0\ufe0f', bg:'linear-gradient(135deg,#fef2f2,#fee2e2)', bc:'#fca5a5', fc:'#7f1d1d', desc:'Con el superintendente' },
    { n:nRiesgo,  lbl:'En riesgo anual',        icon:'\ud83d\udcc9', bg:'linear-gradient(135deg,#fffbeb,#fef3c7)', bc:'#fcd34d', fc:'#78350f', desc:'Menos de 560h proyectadas' },
    { n:nOk,      lbl:'Al d\u00eda',             icon:'\u2705',        bg:'linear-gradient(135deg,#f0faf4,#d1fae5)', bc:'#6ee7b7', fc:'#065f46', desc:'Cumpliendo la meta' },
  ];
  html += '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px">';
  summaryCards.forEach(c => {
    html += '<div style="background:' + c.bg + ';border:1px solid ' + c.bc + ';border-radius:16px;padding:16px 18px;position:relative;overflow:hidden">';
    html += '<div style="font-size:11px;color:' + c.fc + ';font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px">' + c.lbl + '</div>';
    html += '<div style="font-size:36px;font-weight:800;color:' + c.fc + ';font-family:Sora,var(--font);letter-spacing:-1px;line-height:1">' + c.n + '</div>';
    html += '<div style="font-size:10px;color:' + c.fc + ';opacity:.7;margin-top:4px">' + c.desc + '</div>';
    html += '<div style="position:absolute;top:-10px;right:-10px;font-size:48px;opacity:.08">' + c.icon + '</div>';
    html += '</div>';
  });
  html += '</div>';

  // Tarjetas
  datos.forEach(({ pub, d }) => {
    const init = (pub.apellido[0]||'')+(pub.nombre[0]||'');
    const pct = Math.min(100, Math.round(d.horasTotalCombinado/PREC_META_ANIO*100));
    const colorBarra = pct>=100?'#22c55e':pct>=70?'#f59e0b':'#ef4444';
    const claseCard = d.requiereReunion?'reunion-req':d.estado==='riesgo'?'alerta-anual':d.estado==='bajo'?'alerta-mes':'ok';

    html += '<div class="prec-card ' + claseCard + '">';
    const avColor = d.requiereReunion ? 'linear-gradient(135deg,#fee2e2,#fca5a5)' :
                    d.estado==='riesgo'  ? 'linear-gradient(135deg,#fef3c7,#fcd34d)' :
                    d.estado==='bajo'    ? 'linear-gradient(135deg,#fef3c7,#fed7aa)' :
                    'linear-gradient(135deg,#d1fae5,#6ee7b7)';
    const avTextColor = d.requiereReunion ? '#7f1d1d' : d.estado==='ok' ? '#065f46' : '#78350f';
    html += '<div class="prec-card-hdr" style="cursor:pointer" onclick="precAbrirRegistro(\'' + pub.id + '\')" title="Ver registro S-21">';
    html += '<div class="prec-av" style="background:' + avColor + ';color:' + avTextColor + '">' + init + '</div>';
    html += '<div style="flex:1;min-width:0">';
    html += '<div class="prec-nombre" style="display:flex;align-items:center;gap:6px">' + escHtml(pub.apellido) + ', ' + escHtml(pub.nombre);
    html += ' <span style="font-size:10px;color:var(--accent);font-weight:600;background:var(--accent-lt);padding:2px 7px;border-radius:10px">Ver S-21 \u2192</span></div>';
    html += '<div class="prec-grupo">\ud83d\udccc ' + escHtml(pub.grupo||'Sin grupo') + '</div></div>';
    html += '<div class="prec-badges">';
    if(d.requiereReunion) html += '<span class="prec-badge rojo">\u26a0 Reuni\u00f3n requerida</span>';
    else if(d.estado==='riesgo') html += '<span class="prec-badge ambar">\u26a0 Riesgo anual</span>';
    else if(d.estado==='bajo') html += '<span class="prec-badge ambar">Bajo meta</span>';
    else html += '<span class="prec-badge verde">\u2713 Al d\u00eda</span>';
    html += '</div></div>';

    // Stats — basados en total combinado (predicación + betel)
    html += '<div class="prec-stats">';
    html += '<div class="prec-stat"><div class="prec-stat-n" style="color:#b45309">' + Math.round(d.horasTotalCombinado) + '</div><div class="prec-stat-l">Horas totales</div></div>';
    html += '<div class="prec-stat"><div class="prec-stat-n" style="color:' + (d.promedio>=PREC_META_MES?'#16a34a':'#ef4444') + '">' + Math.round(d.promedio*10)/10 + '</div><div class="prec-stat-l">Prom. mensual</div></div>';
    html += '<div class="prec-stat"><div class="prec-stat-n" style="color:' + (d.horasRestantes<=0?'#16a34a':'#b45309') + '">' + Math.round(d.horasRestantes) + '</div><div class="prec-stat-l">Faltan</div></div>';
    html += '<div class="prec-stat"><div class="prec-stat-n" style="color:' + (d.promedioNecesario<=PREC_META_MES?'#16a34a':'#ef4444') + '">' + (d.mesesRestantes>0?Math.round(d.promedioNecesario):'\u2014') + '</div><div class="prec-stat-l">Nec./mes</div></div>';
    if(d.horasBetelCredito > 0) {
      const difiere = Math.round(d.horasBetelBruto) !== Math.round(d.horasBetelCredito);
      html += `<div class="prec-stat" style="background:#f5f3ff;border-color:#c4b5fd">
        <div class="prec-stat-n" style="color:#5b21b6">${Math.round(d.horasBetelCredito)}</div>
        <div class="prec-stat-l" style="color:#7c3aed">Betel acred.</div>
        ${difiere ? `<div style="font-size:9px;color:#a78bfa;margin-top:1px">${Math.round(d.horasBetelBruto)} reales</div>` : ''}
      </div>`;
    }
    html += '</div>';

    // Detalle Betel mes a mes (solo si tiene Betel)
    if(d.horasBetelCredito > 0) {
      const mesCon = d.meses.filter(m => m.betelBruto > 0);
      html += `<div style="margin:0 0 10px;padding:10px 14px;background:#faf5ff;border:1px solid #e9d5ff;border-radius:10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center">`;
      html += `<span style="font-size:10px;font-weight:700;color:#7c3aed;text-transform:uppercase;letter-spacing:.5px;margin-right:4px">Betel por mes</span>`;
      mesCon.forEach(m => {
        const pred = m.horas || 0;
        const total = pred + m.betelCredito;
        const limitado = m.betelCredito < m.betelBruto;
        html += `<span title="Predicación: ${pred}h + Betel: ${m.betelCredito}h = ${total}h${limitado?' (limitado a 55h)':''}" style="background:#ede9fe;color:#5b21b6;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;cursor:default">`;
        html += `${MESES_C[m.idx]}: ${m.betelCredito}h`;
        if(limitado) html += ` <span style="color:#a78bfa;font-weight:500">(${m.betelBruto} real)</span>`;
        html += `</span>`;
      });
      html += `</div>`;
    }

    // Chips mes a mes
    html += '<div class="prec-meses">';
    d.meses.forEach((m,i) => {
      const mesActualIdx = mesActual().idx;
      let clase = 'futuro', valor = '\u2014';
      if(i <= mesActualIdx) {
        if(!m.tieneDatos){ clase='cero'; valor='?'; }
        else if(m.horas>=PREC_META_MES){ clase='sobre'; valor=m.horas; }
        else { clase='bajo'; valor=m.horas; }
      }
      html += '<div class="prec-mes-chip ' + clase + '"><div class="prec-mes-chip-n">' + valor + '</div><div class="prec-mes-chip-l">' + MESES_C[i] + '</div></div>';
    });
    html += '</div>';

    // Barra progreso
    html += '<div class="prec-progreso-wrap">';
    html += '<div class="prec-progreso-label"><span>Progreso anual</span>';
    html += '<span style="font-weight:700;color:' + colorBarra + '">' + Math.round(d.horasTotalCombinado) + ' / ' + PREC_META_ANIO + 'h (' + pct + '%)'
      + (d.horasBetelCredito > 0 ? ` <span style="font-size:10px;font-weight:500;color:#7c3aed">(+${Math.round(d.horasBetelCredito)}h Betel)</span>` : '')
      + '</span></div>';
    html += '<div class="prec-progreso-bar"><div class="prec-progreso-fill" style="width:' + pct + '%;background:' + colorBarra + '"></div></div>';
    html += '</div>';

    // Alertas
    if(d.requiereReunion) {
      html += '<div class="prec-alerta"><strong>\u26a0 Reuni\u00f3n requerida</strong> con el superintendente de servicio y de grupo.<br>';
      html += 'Promedio \u00faltimos meses: <strong>' + Math.round((d.promUlt3||0)*10)/10 + 'h</strong> (meta: ' + PREC_META_MES + 'h). Evaluar circunstancias y si es realista continuar.</div>';
    } else if(d.estado==='riesgo') {
      html += '<div class="prec-alerta ambar"><strong>\u26a0 Riesgo de no alcanzar la meta anual.</strong> Necesita <strong>' + Math.round(d.promedioNecesario) + 'h/mes</strong> en los ' + d.mesesRestantes + ' meses restantes para llegar a ' + PREC_META_ANIO + 'h.</div>';
    }
    html += '</div>';
  });

  // Nota legal
  html += '<div style="margin-top:20px;background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px 16px;font-size:11px;color:var(--ink-3);line-height:1.6">';
  html += '<strong style="color:var(--ink-2)">\ud83d\udcd6 Reglamento:</strong> Si un precursor no informa habitualmente un promedio de 50 horas mensuales, el superintendente de servicio y el de grupo deben reunirse con \u00e9l para ofrecerle ayuda. Al terminar el a\u00f1o de servicio, si llega por lo menos a <strong>560 horas</strong> puede seguir siendo precursor. Si no, el Comit\u00e9 de Servicio determinar\u00e1 si debe continuar.';
  html += '</div></div>';

  root.innerHTML = html;
}


</script>


    { id:'p7',  nombre:'Haga discípulos',                         detalle:'',  mins:5,    seccion:'maestros', doble:true,  rol:'todos', conAyudante:true },
    { id:'p8',  nombre:'Necesidades de la congregación',          detalle:'',  mins:15,   seccion:'vida',     doble:false, rol:'anciano_siervo' },

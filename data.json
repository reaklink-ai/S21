                    </div>
                  </div>
                </div>
                <div class="vym-sala-bloque">
                  <div class="vym-sala-titulo">Sala Auxiliar</div>
                  <div class="vym-sala-fila">
                    <div class="vym-asign">
                      <div class="vym-asign-label">Estudiante</div>
                      <select class="vym-select" onchange="vymSetAsign('${key}','${parte.id}','aux',this.value)">${vymOpcionesSelect('todos',vAux)}</select>
                    </div>
                    <div class="vym-asign">
                      <div class="vym-asign-label">Ayudante</div>
                      <select class="vym-select" onchange="vymSetAsign('${key}','${parte.id}','aux_ayud',this.value)">${vymOpcionesSelect('todos',vAuxAyud)}</select>
                    </div>
                  </div>
                </div>
              ` : parte.doble ? `
                <div class="vym-asign">
                  <div class="vym-asign-label">Sala principal</div>
                  <select class="vym-select${clsAnc}" onchange="vymSetAsign('${key}','${parte.id}','prin',this.value)">${vymOpcionesSelect(rol,vPrin)}</select>
                </div>
                <div class="vym-asign">
                  <div class="vym-asign-label">Sala auxiliar</div>
                  <select class="vym-select" onchange="vymSetAsign('${key}','${parte.id}','aux',this.value)">${vymOpcionesSelect('todos',vAux)}</select>
                </div>
              ` : `
                <div class="vym-asign">
                  <div class="vym-asign-label">${parte.esLector?'Lector':'Asignado'}</div>
                  <select class="vym-select${clsAnc}" onchange="vymSetAsign('${key}','${parte.id}','prin',this.value)">${vymOpcionesSelect(rol,vPrin)}</select>
                </div>
              `}
            </div>
          </div>`;
        });
        html += `</div>`;
      });
    }
    html += `</div>`;
  }

  html += `</div>`;
  root.innerHTML = html;
  vymMarcarDuplicados();

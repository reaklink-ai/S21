function renderUsuariosModal() {
  const users = getUsuarios();

  const SECCIONES = [
    { key:'publicadores', label:'Publicadores' },
    { key:'grupos',       label:'Grupos' },
    { key:'vym',          label:'Vida y Ministerio' },
    { key:'metricas',     label:'Métricas' },
    { key:'inactivos',    label:'Inactivos' },
    { key:'datos',        label:'Datos/Admin' },
  ];

  // Defaults de acceso por rol (admin/secretario siempre ven todo)
  const DEFAULTS = {
    anciano:  { publicadores:true, grupos:true, vym:true, metricas:false, inactivos:false, datos:false },
    lector:   { publicadores:true, grupos:true, vym:false, metricas:false, inactivos:false, datos:false },
  };

  const lista = users.map(u => {
    const esProtegido = u.id === 'admin';
    const esSuperRol = u.rol === 'admin' || u.rol === 'secretario';
    const accesos = u.accesos || {};

    // Checkboxes de secciones (solo para anciano/lector)
    let checkboxes = '';
    if(!esSuperRol) {
      const def = DEFAULTS[u.rol] || {};
      checkboxes = '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">' +
        SECCIONES.map(s => {
          const val = typeof accesos[s.key] !== 'undefined' ? accesos[s.key] : (def[s.key]||false);
          return `<label style="display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ink-2);cursor:pointer;background:var(--surface-2);border:1px solid var(--border);border-radius:6px;padding:3px 8px">
            <input type="checkbox" ${val?'checked':''} onchange="toggleAcceso('${u.id}','${s.key}',this.checked)"
              style="cursor:pointer;accent-color:var(--accent)">
            ${s.label}
          </label>`;
        }).join('') +
      '</div>';
    } else {
      checkboxes = '<div style="font-size:10px;color:var(--ink-3);margin-top:4px">Acceso completo según rol</div>';
    }

    return `<div class="usr-item" style="flex-direction:column;align-items:stretch;gap:6px">
      <div style="display:flex;align-items:center;gap:10px">
        <div class="usr-av" style="background:${getRolColor(u.rol)}22;color:${getRolColor(u.rol)}">${(u.nombre||'?')[0]}</div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:600;color:var(--ink)">${escHtml(u.nombre||'?')}</div>
          <div style="font-size:11px;color:${getRolColor(u.rol)};font-weight:600">${getRolLabel(u.rol)}${u.grupo?' · '+u.grupo:''}</div>
        </div>
        <div style="display:flex;align-items:center;gap:6px">
          <div style="font-family:var(--font-mono);font-size:12px;color:var(--ink-3);background:var(--surface-2);padding:3px 8px;border-radius:4px;border:1px solid var(--border)">PIN: ${u.pin}</div>
          <button onclick="cambiarPin('${u.id}')" style="background:none;border:1px solid var(--border);border-radius:4px;color:var(--ink-2);cursor:pointer;font-size:11px;padding:3px 8px;font-family:var(--font);font-weight:600">✏</button>
          ${!esProtegido ? `<button onclick="eliminarUsuario('${u.id}')" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:16px;padding:4px 8px">×</button>` : '<span style="font-size:10px;color:var(--ink-3);padding:0 8px">protegido</span>'}
        </div>
      </div>
      ${checkboxes}
    </div>`;
  }).join('');

  document.getElementById('usuariosLista').innerHTML = lista || '<p style="color:var(--ink-3);font-size:13px">No hay usuarios</p>';
}

function toggleAcceso(userId, seccion, valor) {
  const users = getUsuarios();
  const u = users.find(x => x.id === userId);
  if(!u) return;
  if(!u.accesos) u.accesos = {};
  u.accesos[seccion] = valor;
  state.usuarios = users;
  saveStateAndSync();
  // Si es el usuario actual, refrescar UI
  if(currentUser && currentUser.id === userId) {
    currentUser.accesos = u.accesos;
    applyRoleUI();
  }
  toast('Permiso actualizado');
}

function cambiarPin(id) {
  const users = getUsuarios();
  const u = users.find(x => x.id === id);
  if(!u) return;
  const nuevo = prompt(`Nuevo PIN para "${u.nombre}" (mínimo 4 dígitos):`);
  if(nuevo === null) return;
  if(!nuevo || nuevo.trim().length < 4) { toast('El PIN debe tener al menos 4 caracteres'); return; }
  const pinLimpio = nuevo.trim();
  if(users.find(x => x.id !== id && x.pin === pinLimpio)) { toast('Ese PIN ya está en uso por otro usuario'); return; }
  u.pin = pinLimpio;
  state.usuarios = users;
  saveStateAndSync();
  renderUsuariosModal();
  toast(`PIN de "${u.nombre}" actualizado`);
}

function agregarUsuario() {
  const nombre = document.getElementById('nuevoNombre').value.trim();
  const pin    = document.getElementById('nuevoPin').value.trim();
  const rol    = document.getElementById('nuevoRol').value;
  const grupo  = document.getElementById('nuevoGrupo').value;

  if(!nombre || !pin) { toast('Completa nombre y PIN'); return; }
  if(pin.length < 4)  { toast('El PIN debe tener al menos 4 caracteres'); return; }

  const users = getUsuarios();
  if(users.find(u => u.pin === pin)) { toast('Ese PIN ya está en uso'); return; }

  const id = Date.now().toString(36);
  users.push({ id, nombre, pin, rol, grupo: grupo || null });
  state.usuarios = users;
  saveStateAndSync();
  renderUsuariosModal();
  document.getElementById('nuevoNombre').value = '';
  document.getElementById('nuevoPin').value = '';
  toast(`Usuario "${nombre}" creado`);
}

function eliminarUsuario(id) {
  if(!confirm('¿Eliminar este usuario?')) return;
  state.usuarios = getUsuarios().filter(u => u.id !== id);
  saveStateAndSync();
  renderUsuariosModal();
  toast('Usuario eliminado');
}


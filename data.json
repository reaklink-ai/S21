    { id:'p9l', nombre:'Lector (estudio bíblico)',                detalle:'',  mins:null, seccion:'vida',     doble:false, rol:'anciano_siervo', esLector:true },
    { id:'p10', nombre:'Palabras de conclusión',                  mins:3,    seccion:'cierre',   doble:false, rol:'anciano' },
  ];

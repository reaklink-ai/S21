function getVymState() {
  if(!state.vym) state.vym = { semanas: {} };
  return state.vym;
}

function vymUrlPorFecha(fecha) {
  const ancla = new Date(2026, 2, 16);
  const anclaId = 202026083;
  const diffSem = Math.round((fecha - ancla) / (7 * 24 * 3600 * 1000));
  return anclaId + (diffSem * 7);
}

function vymLunesDeSemana(offset) {
  const hoy = new Date();
  const dia = hoy.getDay();
  const lunes = new Date(hoy);
  lunes.setDate(hoy.getDate() - (dia === 0 ? 6 : dia - 1) + offset * 7);
  lunes.setHours(0,0,0,0);
  return lunes;
}

function vymFechaLabel(fecha) {
  const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const fin = new Date(fecha); fin.setDate(fin.getDate() + 6);
  if(fecha.getMonth() === fin.getMonth())
    return `${fecha.getDate()}\u2013${fin.getDate()} de ${meses[fecha.getMonth()]} de ${fecha.getFullYear()}`;
  return `${fecha.getDate()} de ${meses[fecha.getMonth()]} \u2013 ${fin.getDate()} de ${meses[fin.getMonth()]} de ${fecha.getFullYear()}`;
}

function vymSemanaKey(fecha) {
  return fecha.toISOString().slice(0,10);
}


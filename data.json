let editId=null;


// ── Modal checkbox/radio toggle helpers ──
function mfToggleChk(label, id) {
  const inp = document.getElementById(id);
  if(!inp) return;
  inp.checked = !inp.checked;
  label.classList.toggle('mf-chk-on', inp.checked);
}
function mfToggleRadio(name, value) {
  document.querySelectorAll(`.mf-chk-radio`).forEach(lbl => {
    const inp = lbl.querySelector('input[type=radio]');
    if(!inp || inp.name !== name) return;
    inp.checked = inp.value === value;
    lbl.classList.toggle('mf-chk-on', inp.checked);
  });
}
function mfSyncVisual() {
  // Sync all mf-chk visual state from their input
  document.querySelectorAll('.mf-chk').forEach(lbl => {
    const inp = lbl.querySelector('input');
    if(!inp) return;
    lbl.classList.toggle('mf-chk-on', inp.checked);
  });
}

function abrirModalNuevo() {
  editId=null;
  document.getElementById('modalTitulo').textContent='Nuevo publicador';
  document.getElementById('btnEliminar').style.display='none';
  limpiarForm();
  document.getElementById('fHombre').checked=true;
  document.getElementById('modalPub').style.display='flex'; setTimeout(mfSyncVisual,0); setTimeout(mfSyncVisual,0);
}

function abrirModalEditar(id) {
  editId=id;
  const p=getPub(id);
  document.getElementById('modalTitulo').textContent='Editar publicador';
  document.getElementById('btnEliminar').style.display='inline-block';
  limpiarForm();
  document.getElementById('fApellido').value=p.apellido||'';
  document.getElementById('fNombre').value=p.nombre||'';
  document.getElementById('fNacimiento').value=p.nacimiento||'';
  document.getElementById('fBautismo').value=p.bautismo||'';
  document.getElementById('fGrupo').value=p.grupo||'';
  document.getElementById('fTelefono').value=p.telefono||'';
  if(p.genero==='M') document.getElementById('fHombre').checked=true;
  if(p.genero==='F') document.getElementById('fMujer').checked=true;
  ['otrasOvejas','ungido','anciano','siervo','precursorReg','precursorEsp','misionero'].forEach(k=>{
    const el=document.getElementById('f'+k[0].toUpperCase()+k.slice(1));
    if(el) el.checked=!!p[k];
  });
  // Emergencia
  const e = p.emergencia||{};
  document.getElementById('fEmergNombre').value = e.nombre||'';
  document.getElementById('fEmergRelacion').value = e.relacion||'';
  document.getElementById('fEmergTel').value = e.tel||'';
  document.getElementById('fEmergTel2').value = e.tel2||'';
  document.getElementById('fDireccion').value = e.direccion||'';
  document.getElementById('fNotasMed').value = e.notasMed||'';
  document.getElementById('modalPub').style.display='flex';
}

function limpiarForm() {
  ['fApellido','fNombre','fNacimiento','fBautismo','fTelefono',
   'fEmergNombre','fEmergTel','fEmergTel2',
   'fDireccion','fNotasMed'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  document.getElementById('fGrupo').value='';
  document.getElementById('fEmergRelacion').value='';
  document.querySelectorAll('input[name="gen"]').forEach(r=>r.checked=false);
  ['fOtrasOvejas','fUngido','fAnciano','fSiervo','fPrecursorReg','fPrecursorEsp','fMisionero'].forEach(id=>document.getElementById(id).checked=false);
  switchTab('datos');
}

function cerrarModal() { document.getElementById('modalPub').style.display='none'; }

function guardarPub() {
  const ap=document.getElementById('fApellido').value.trim();
  const nom=document.getElementById('fNombre').value.trim();
  if(!ap||!nom){ alert('Apellido y nombre son obligatorios'); return; }
  const datos={
    apellido:ap, nombre:nom,
    nacimiento:document.getElementById('fNacimiento').value,
    bautismo:document.getElementById('fBautismo').value,
    grupo:document.getElementById('fGrupo').value,
    telefono:document.getElementById('fTelefono').value,
    genero:document.querySelector('input[name="gen"]:checked')?.value||'M',
    otrasOvejas:document.getElementById('fOtrasOvejas').checked,
    ungido:document.getElementById('fUngido').checked,
    anciano:document.getElementById('fAnciano').checked,
    siervo:document.getElementById('fSiervo').checked,
    precursorReg:document.getElementById('fPrecursorReg').checked,
    precursorEsp:document.getElementById('fPrecursorEsp').checked,
    misionero:document.getElementById('fMisionero').checked,
    emergencia:{
      nombre:document.getElementById('fEmergNombre').value.trim(),
      relacion:document.getElementById('fEmergRelacion').value,
      tel:document.getElementById('fEmergTel').value.trim(),
      tel2:document.getElementById('fEmergTel2').value.trim(),
      direccion:document.getElementById('fDireccion').value.trim(),
      notasMed:document.getElementById('fNotasMed').value.trim(),
    }
  };
  if(editId){ Object.assign(getPub(editId),datos); }
  else { const p={id:'p'+Date.now(),registros:{},...datos}; state.publicadores.push(p); selId=p.id; }
  saveStateAndSync(); cerrarModal(); renderLista();
  if(selId) renderS21();
  toast('Guardado ✓');
}

function eliminarPub() {
  if(!confirm('¿Eliminar este publicador y todo su historial?')) return;
  state.publicadores=state.publicadores.filter(p=>p.id!==editId);
  if(selId===editId){ selId=null; document.getElementById('mainArea').innerHTML='<div class="empty"><div class="empty-icon"></div><div class="empty-txt">Selecciona un publicador.</div></div>'; }
  saveStateAndSync(); cerrarModal(); renderLista(); toast('Eliminado');
}

